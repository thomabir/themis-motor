Notebook[{

Cell[CellGroupData[{
Cell["Themis Control Overview", "Title",
 CellChangeTimes->{{3.963039722142427*^9, 
  3.963039729474371*^9}},ExpressionUUID->"99b4e933-a364-4fc3-927b-\
ef27bd2b95e5"],

Cell["\<\
Goal: derive analytical expressions for theta_rms given some assumptions \
about mount and disturbances\
\>", "Text",
 CellChangeTimes->{{3.9630397322262793`*^9, 
  3.963039762360536*^9}},ExpressionUUID->"9ca78fb6-0894-4525-8d03-\
b718c28524cf"],

Cell[CellGroupData[{

Cell["Model", "Chapter",
 CellChangeTimes->{{3.963039771273364*^9, 
  3.9630397772132807`*^9}},ExpressionUUID->"d5408b00-8d9c-4b0c-bb4f-\
6d13e8cfebb0"],

Cell["Motor modelling: https://arxiv.org/pdf/2310.00080", "Text",
 CellChangeTimes->{{3.963040520657275*^9, 
  3.963040525883129*^9}},ExpressionUUID->"0e5aacb4-2a21-4a64-b94a-\
82784f91422b"],

Cell["Mechanical plant:", "Text",
 CellChangeTimes->{{3.963039792054697*^9, 3.9630397949847193`*^9}, 
   3.96304053466426*^9, 
   3.963040807108221*^9},ExpressionUUID->"2de4b8f3-1adf-40c9-969f-\
7ec110b0d341"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"J", " ", "\[Omega]", " ", "s"}], "+", 
   RowBox[{"b", " ", "\[Omega]"}]}], "==", 
  RowBox[{
   RowBox[{"KT", " ", "i"}], "+", "\[Tau]d"}]}]], "Input",
 CellChangeTimes->{{3.963040811185341*^9, 
  3.9630408465244627`*^9}},ExpressionUUID->"9df04835-02ba-4e47-b95d-\
1adf3f87affe"],

Cell["Electrical plant:", "Text",
 CellChangeTimes->{{3.963040799551221*^9, 
  3.9630408041396646`*^9}},ExpressionUUID->"9a651b45-76a1-46ca-9ee6-\
a0d190c0e1a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"L", " ", "i", " ", "s"}], "+", 
     RowBox[{"R", " ", "i"}], "+", 
     RowBox[{"KE", " ", "\[Omega]"}]}], "==", "V"}], ",", "i"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.963040688335678*^9, 3.963040742491599*^9}, {
  3.963040980851323*^9, 3.9630409862722883`*^9}},
 CellLabel->
  "In[855]:=",ExpressionUUID->"066e28ac-c1e9-4e29-9447-2d431fa97464"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"i", "\[Rule]", 
    FractionBox[
     RowBox[{"V", "-", 
      RowBox[{"KE", " ", "\[Omega]"}]}], 
     RowBox[{"R", "+", 
      RowBox[{"L", " ", "s"}]}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.963040735169115*^9, 3.963040742805625*^9}, {
  3.963040981381049*^9, 3.96304098665586*^9}},
 CellLabel->
  "Out[855]=",ExpressionUUID->"b39ce80b-7e12-4982-87c5-70762a03769d"]
}, Open  ]],

Cell["There is a pole at s = - R/L, frequency \[Omega]e = R/L", "Text",
 CellChangeTimes->{{3.963041567667677*^9, 3.9630415808648977`*^9}, {
  3.963042119668097*^9, 
  3.963042131975388*^9}},ExpressionUUID->"322bfb03-c7fc-4afa-9975-\
65c813af646b"],

Cell["\<\
Since \[Omega] is very small, the KE term can be neglected, and the gain from \
voltage to torque is thus\
\>", "Text",
 CellChangeTimes->{{3.963041985974725*^9, 
  3.963042023913454*^9}},ExpressionUUID->"db3cf2c9-9b43-4470-99b3-\
d924043aa9f1"],

Cell[BoxData[
 RowBox[{
  FractionBox["KT", 
   RowBox[{"R", "+", 
    RowBox[{"L", " ", "s"}]}]], "=", 
  RowBox[{
   FractionBox["KT", "R"], " ", 
   FractionBox["\[Omega]E", 
    RowBox[{"s", "+", "\[Omega]E"}]]}]}]], "Input",
 CellChangeTimes->{{3.963042039766645*^9, 3.963042045194014*^9}, {
  3.9630421067857533`*^9, 3.9630421479078627`*^9}, {3.963042340647547*^9, 
  3.9630423410865583`*^9}},ExpressionUUID->"4a50abd9-2f01-4c7c-9bf5-\
136afd18cabf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    FractionBox["KT", "R"], " ", 
    FractionBox["\[Omega]E", 
     RowBox[{"s", "+", "\[Omega]E"}]]}], "/.", 
   RowBox[{"{", 
    RowBox[{"\[Omega]E", "->", 
     FractionBox["R", "L"]}], "}"}]}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.963042192971715*^9, 3.963042204526767*^9}, {
  3.963042335923036*^9, 3.963042336865218*^9}},
 CellLabel->
  "In[863]:=",ExpressionUUID->"1384c288-6227-4069-b48e-4dcd064b3c4a"],

Cell[BoxData[
 FractionBox["KT", 
  RowBox[{"R", "+", 
   RowBox[{"L", " ", "s"}]}]]], "Output",
 CellChangeTimes->{3.963042204812086*^9, 3.9630423372648497`*^9},
 CellLabel->
  "Out[863]=",ExpressionUUID->"00de7253-abe9-4eb0-a2e7-b27e73dcfd2a"]
}, Open  ]],

Cell["\<\
The transfer from voltage to current could benefit stabilisation\
\>", "Text",
 CellChangeTimes->{{3.963045050390121*^9, 
  3.9630450706336203`*^9}},ExpressionUUID->"a3ef9b2d-cbde-4cef-86c5-\
a7bbce1f3c17"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Loops", "Chapter",
 CellChangeTimes->{{3.963040793600758*^9, 
  3.9630407946723127`*^9}},ExpressionUUID->"0ea9a376-ec1a-48db-ab3f-\
83a0a2531447"],

Cell[CellGroupData[{

Cell["Current sensor", "Section",
 CellChangeTimes->{{3.963041291838614*^9, 
  3.9630412964652653`*^9}},ExpressionUUID->"c48c02b9-e345-4ff7-9f10-\
26b900f92bcc"],

Cell["We want to get rid of the pole from voltage to torque:", "Text",
 CellChangeTimes->{{3.963042904696177*^9, 3.963042908552885*^9}, {
  3.9630433691846113`*^9, 
  3.963043372900481*^9}},ExpressionUUID->"2f2f6730-4a41-4a85-a7f2-\
3a4608288cf3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GE", "=", 
   RowBox[{
    FractionBox["KT", "R"], " ", 
    FractionBox["\[Omega]E", 
     RowBox[{"s", "+", "\[Omega]E"}]]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9630431523243637`*^9, 3.96304315594137*^9}},
 CellLabel->
  "In[867]:=",ExpressionUUID->"f313c6b5-388f-4dad-8404-a5a0a67b12aa"],

Cell["We introduce a PI with gain", "Text",
 CellChangeTimes->{{3.9630429134068604`*^9, 
  3.963042926115509*^9}},ExpressionUUID->"db4586c0-2edd-41b2-8615-\
095fde405256"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GC", "=", 
   RowBox[{"Kp", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox["\[Omega]E", "s"]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.963042928238117*^9, 3.963042953722652*^9}, {
  3.963043159484653*^9, 3.9630431628138638`*^9}},
 CellLabel->
  "In[868]:=",ExpressionUUID->"9c713aa0-700e-4cba-861a-6ef77c03ab74"],

Cell["The open loop gain is then", "Text",
 CellChangeTimes->{{3.963043031837452*^9, 
  3.9630430361816874`*^9}},ExpressionUUID->"e1979f32-e437-4a36-a45e-\
9e0833e3c1cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GL", "=", 
  RowBox[{
   RowBox[{"GE", "*", "GC"}], "//", "FullSimplify"}]}]], "Input",
 CellChangeTimes->{{3.963043041250243*^9, 3.9630430479716587`*^9}, {
  3.963043166870183*^9, 3.963043171625223*^9}},
 CellLabel->
  "In[869]:=",ExpressionUUID->"d8244352-27bd-4bb7-b0b7-af04c3f43bfb"],

Cell[BoxData[
 FractionBox[
  RowBox[{"Kp", " ", "KT", " ", "\[Omega]E"}], 
  RowBox[{"R", " ", "s"}]]], "Output",
 CellChangeTimes->{3.963043048233199*^9, 3.9630431722145023`*^9},
 CellLabel->
  "Out[869]=",ExpressionUUID->"690949f8-3539-45b7-9602-23baad95e7b9"]
}, Open  ]],

Cell["\<\
and the closed loop gain is (needs a torque measurement, which we proxy via a \
current measurement)\
\>", "Text",
 CellChangeTimes->{{3.963043061392543*^9, 3.963043068348634*^9}, {
  3.963043388306698*^9, 
  3.96304340134225*^9}},ExpressionUUID->"6d541295-74b4-48a8-b46c-\
bb3c8171c7e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["GL", 
    RowBox[{"1", "+", "GL"}]], "/.", 
   RowBox[{"{", 
    RowBox[{"Kp", "->", 
     RowBox[{"R", " ", "\[Omega]ci"}]}], "}"}]}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9630430774791594`*^9, 3.963043084280526*^9}, {
  3.9630431757116823`*^9, 3.9630432055823193`*^9}},
 CellLabel->
  "In[872]:=",ExpressionUUID->"0fc40adb-7656-49a0-9b1f-59149d5d8b97"],

Cell[BoxData[
 FractionBox[
  RowBox[{"KT", " ", "\[Omega]ci", " ", "\[Omega]E"}], 
  RowBox[{"s", "+", 
   RowBox[{"KT", " ", "\[Omega]ci", " ", "\[Omega]E"}]}]]], "Output",
 CellChangeTimes->{
  3.963043084564329*^9, {3.9630431779584637`*^9, 3.96304320616292*^9}},
 CellLabel->
  "Out[872]=",ExpressionUUID->"b6cb8d77-7808-4de5-8ad0-2b60ac10edfc"]
}, Open  ]],

Cell["PI for current regulation with closed-loop TF (assumption)", "Text",
 CellChangeTimes->{{3.963041052417388*^9, 3.963041057098173*^9}, {
  3.963041238034334*^9, 3.963041244899725*^9}, {3.9630417720371637`*^9, 
  3.963041777273385*^9}},ExpressionUUID->"43d1d321-2d33-4f81-aa8d-\
2fe9a36d4110"],

Cell[BoxData[
 RowBox[{
  FractionBox["Iact", "Icmd"], "==", 
  FractionBox["\[Omega]ci", 
   RowBox[{"s", "+", "\[Omega]ci"}]]}]], "Input",
 CellChangeTimes->{{3.963041250748773*^9, 3.963041273456596*^9}, {
  3.96304188248447*^9, 
  3.9630418833452187`*^9}},ExpressionUUID->"e8f13d9e-7a06-4fe8-bc25-\
293f5dc3b062"],

Cell[CellGroupData[{

