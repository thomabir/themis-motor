Notebook[{

Cell[CellGroupData[{
Cell["Motor model pole cancellation", "Title",
 CellChangeTimes->{{3.963043703948387*^9, 
  3.963043712770196*^9}},ExpressionUUID->"777dc698-d120-4744-99bf-\
ba103626458a"],

Cell["Voltage to torque gain:", "Text",
 CellChangeTimes->{{3.963043720242384*^9, 
  3.963043725718539*^9}},ExpressionUUID->"75a4d911-c48a-4573-9d2d-\
2361eff99dad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GE", "=", 
   RowBox[{
    FractionBox["KT", "R"], " ", 
    FractionBox["\[Omega]E", 
     RowBox[{"s", "+", "\[Omega]E"}]]}]}], ";"}]], "Input",
 CellLabel->
  "In[873]:=",ExpressionUUID->"cf6efea8-e7f5-48e1-88f5-531ea09c4dc7"],

Cell["PI controller for plant inversion:", "Text",
 CellChangeTimes->{{3.963043733647999*^9, 
  3.963043739774406*^9}},ExpressionUUID->"edeabfe5-c0c5-4856-b7ae-\
e8bc850768fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GC", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Omega]ci", " ", "R"}], 
     RowBox[{"KT", " ", "\[Omega]E"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox["\[Omega]E", "s"]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.963043783718864*^9, 3.963043828999158*^9}},
 CellLabel->
  "In[881]:=",ExpressionUUID->"5896871c-e034-4def-ab1e-8a7976c4a832"],

Cell["Closed loop transfer function:", "Text",
 CellChangeTimes->{{3.9630437510888157`*^9, 
  3.963043754604025*^9}},ExpressionUUID->"7f86c235-8f32-4e95-a003-\
7275803649a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"GE", " ", "GC", " "}], 
   RowBox[{"1", "+", 
    RowBox[{"GE", " ", "GC"}]}]], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9630437610638227`*^9, 3.963043773136405*^9}},
 CellLabel->
  "In[882]:=",ExpressionUUID->"6d75a702-ac11-4d28-b7fe-44bd093bc006"],

Cell[BoxData[
 FractionBox["\[Omega]ci", 
  RowBox[{"s", "+", "\[Omega]ci"}]]], "Output",
 CellChangeTimes->{
  3.963043773353058*^9, {3.963043809026672*^9, 3.9630438306787157`*^9}},
 CellLabel->
  "Out[882]=",ExpressionUUID->"71be6a57-1aef-43cd-a553-d4e3b3d7acf1"]
}, Open  ]],

Cell["What if there\[CloseCurlyQuote]s some error in the model, let\
\[CloseCurlyQuote]s say in \[Omega]E?", "Text",
 CellChangeTimes->{{3.963043835251975*^9, 3.963043841745676*^9}, {
  3.9630440125287247`*^9, 
  3.963044020330286*^9}},ExpressionUUID->"3d365bf1-0fe7-48d6-bdf7-\
fdacb4518e88"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GE", "=", 
   RowBox[{
    FractionBox["KT", "R"], " ", 
    FractionBox["\[Omega]E", 
     RowBox[{"s", "+", "\[Omega]E"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GC", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Omega]ci", " ", "R"}], 
     RowBox[{"KT", " ", "x", " ", "\[Omega]E"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox[
       RowBox[{"x", " ", "\[Omega]E"}], "s"]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"GCL", "=", 
  RowBox[{
   FractionBox[
    RowBox[{"GE", " ", "GC", " "}], 
    RowBox[{"1", "+", 
     RowBox[{"GE", " ", "GC"}]}]], "//", "FullSimplify"}]}]}], "Input",
 CellChangeTimes->{{3.9630438519979963`*^9, 3.963043910421083*^9}, {
   3.963043943363776*^9, 3.9630439445642767`*^9}, {3.963044147604746*^9, 
   3.9630441480327883`*^9}, 3.963069986295322*^9, 3.963070031408498*^9},
 CellLabel->
  "In[926]:=",ExpressionUUID->"75325853-81d5-45a1-bb3d-4a0b5b4fd31b"],

Cell[BoxData[
 FractionBox[
  RowBox[{"\[Omega]ci", " ", 
   RowBox[{"(", 
    RowBox[{"s", "+", 
     RowBox[{"x", " ", "\[Omega]E"}]}], ")"}]}], 
  RowBox[{
   RowBox[{"s", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"s", " ", "x"}], "+", "\[Omega]ci"}], ")"}]}], "+", 
   RowBox[{"x", " ", 
    RowBox[{"(", 
     RowBox[{"s", "+", "\[Omega]ci"}], ")"}], " ", "\[Omega]E"}]}]]], "Output",\

 CellChangeTimes->{{3.963043862718178*^9, 3.963043868590097*^9}, 
   3.963043910850484*^9, 3.963043947216733*^9, 3.963044148555126*^9, 
   3.9630699866104*^9, 3.963070031759536*^9},
 CellLabel->
  "Out[928]=",ExpressionUUID->"e320d64e-324d-49d9-a62f-6a2df2d1411e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["\[Omega]E", 
      RowBox[{"s", "+", "\[Omega]E"}]], ",", 
     FractionBox[
      RowBox[{"GE", " ", "GC", " "}], 
      RowBox[{"1", "+", 
       RowBox[{"GE", " ", "GC"}]}]]}], "}"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Omega]E", "->", "10"}], ",", 
     RowBox[{"\[Omega]ci", "->", "300"}]}], "}"}]}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.963070040824469*^9, 3.963070050987392*^9}},
 CellLabel->
  "In[929]:=",ExpressionUUID->"533aedf0-9b7d-4ec7-bd90-9d810314d8be"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["10", 
    RowBox[{"10", "+", "s"}]], ",", 
   FractionBox[
    RowBox[{"300", " ", 
     RowBox[{"(", 
      RowBox[{"s", "+", 
       RowBox[{"10", " ", "x"}]}], ")"}]}], 
    RowBox[{
     RowBox[{"300", " ", "s"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3000", "+", 
        RowBox[{"s", " ", 
         RowBox[{"(", 
          RowBox[{"10", "+", "s"}], ")"}]}]}], ")"}], " ", "x"}]}]]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9630700559319353`*^9},
 CellLabel->
  "Out[929]=",ExpressionUUID->"3597472f-4f29-41ae-9cc5-b83ee77d9b84"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"LogLinearPlot", "[", 
