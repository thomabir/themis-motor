       RowBox[{
       "L", ",", "I1", ",", "R", ",", "\[Omega]", ",", "\[Omega]0", ",", 
        "C"}], "}"}], "\[Element]", "PositiveReals"}]}], "]"}], 
   "&"}]}]], "Input",
 CellChangeTimes->{{3.9634870221156607`*^9, 3.9634870343783283`*^9}, 
   3.963487364116727*^9, 3.963487464689444*^9, {3.963487555194137*^9, 
   3.963487562222459*^9}, {3.963487606329417*^9, 3.963487625341565*^9}, {
