02039d22c78f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Vo", "==", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      SuperscriptBox["C", "2"], " ", 
      SuperscriptBox["L", "2"], " ", 
      SuperscriptBox["s", "4"], " ", "Vi"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"C", " ", "R", " ", "s"}]}], ")"}], " ", 
