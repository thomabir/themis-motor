Cell["\<\
So the new circuit (with added L2) is much better than the old one, and the \
second-order approximation for the new one is not that great, unless L2>>L by \
a lot.\
\>", "Text",
 CellChangeTimes->{{3.945436884530149*^9, 3.945436899769476*^9}, {
  3.9454369347149897`*^9, 3.945436953218463*^9}, {3.945437829734725*^9, 
  3.94543783914997*^9}},ExpressionUUID->"6d2fb63d-f385-401e-aa90-\
79f61ef464ab"],

Cell[TextData[{
 "Some insight:\n- The peak gain has diminishing returns when increasing L2, \
at some point it\[CloseCurlyQuote]s no longer relevant (since the expression \
then simplifies to L/(C R^2)\n- Decreasing C and R is always good to increase \
gain, especially R\n\t- Probably R is inv.prop. to Q, just intuitively. Same \
with C I guess.\n- Resonance is ",
 Cell[BoxData[
  FractionBox["1", 
   SqrtBox[
    RowBox[{"C", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "L"}], "+", "L2"}], ")"}]}]]]],
  CellChangeTimes->{{3.9454363239428663`*^9, 3.945436337478217*^9}},
  ExpressionUUID->"c5e05a48-ac3e-4ce9-9603-bc2b3b5d550c"],
 ", or approximately",
 Cell[BoxData[
  FractionBox["1", 
   SqrtBox[
    RowBox[{"C", " ", "L2"}]]]],
  CellChangeTimes->{{3.9454363239428663`*^9, 3.945436337478217*^9}},
  ExpressionUUID->"a384fad6-ca1c-4c97-87eb-e0b637fb7f67"],
 ", so to decrease resonance frequency, increase C or L2 (L2 may be better, \
since it also increases gain)"
}], "Text",
 CellChangeTimes->{{3.945437916368864*^9, 3.9454380069932003`*^9}, {
  3.945438912718588*^9, 3.945438982415516*^9}, {3.945439219544703*^9, 
  3.945439239425132*^9}},ExpressionUUID->"6b2ccdf7-2d0b-4cd4-b9aa-\
ef6b2af3d39c"],

Cell["Actual condition for approximation:", "Text",
 CellChangeTimes->{{3.945525462975542*^9, 
  3.94552546803056*^9}},ExpressionUUID->"8471fb90-f913-4490-a354-\
1a74e70fef56"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["L", "2"]}], "<", 
      RowBox[{"C", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "L"}], "+", "L2"}], ")"}], " ", 
       SuperscriptBox["R", "2"]}]}], ",", "L"}], "]"}], "//", 
   RowBox[{
