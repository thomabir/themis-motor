c884c2c76d05"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sol\[Omega]", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Omega]1", "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       SqrtBox[
        RowBox[{
         FractionBox["4", 
          RowBox[{"C", " ", "L2"}]], "-", 
         FractionBox[
          SuperscriptBox["R", "2"], 
          SuperscriptBox["L2", "2"]], "-", 
         FractionBox[
          RowBox[{"R", " ", 
           SqrtBox[
            RowBox[{
             RowBox[{
              RowBox[{"-", "8"}], " ", "L2"}], "+", 
             RowBox[{"C", " ", 
