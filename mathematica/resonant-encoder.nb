          RowBox[{
           SqrtBox["C"], " ", 
           SuperscriptBox["L2", "2"]}]]}]]}]}], ",", 
     RowBox[{"\[Omega]2", "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], 
       SqrtBox[
        RowBox[{
         FractionBox["4", 
          RowBox[{"C", " ", "L2"}]], "-", 
         FractionBox[
          SuperscriptBox["R", "2"], 
          SuperscriptBox["L2", "2"]], "+", 
