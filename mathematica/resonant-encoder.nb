      RowBox[{
       SuperscriptBox["L", "2"], " ", 
       SuperscriptBox["\[Omega]", "2"]}], "R"]}], ")"}]}]]], "Output",
 CellChangeTimes->{{3.9635757133380404`*^9, 3.9635757277516212`*^9}},
