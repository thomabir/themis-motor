  "Out[189]=",ExpressionUUID->"13f782ce-7ee3-4f31-b3b5-67b5b0854308"]
}, Open  ]],

Cell["\<\
The impedance of the source circuit that the current source has to drive is\
\>", "Text",
 CellChangeTimes->{{3.963575904171919*^9, 
  3.96357591482663*^9}},ExpressionUUID->"28047954-6943-4508-ab49-\
c35bba5ebf4f"],

