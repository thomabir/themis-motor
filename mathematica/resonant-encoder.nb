        SuperscriptBox["L2", "2"]}]], "+", 
      FractionBox[
       RowBox[{"R", " ", 
        SqrtBox[
         RowBox[{
          RowBox[{
           RowBox[{"-", "8"}], " ", "L2"}], "+", 
          RowBox[{"C", " ", 
           SuperscriptBox["R", "2"]}]}]]}], 
       RowBox[{"4", " ", 
        SqrtBox["C"], " ", 
        SuperscriptBox["L2", "2"]}]]}]]}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9454384298908*^9, 3.9454384403332167`*^9}, {
  3.945438572794736*^9, 
  3.945438573858163*^9}},ExpressionUUID->"e0f831c9-91de-4126-974e-\
