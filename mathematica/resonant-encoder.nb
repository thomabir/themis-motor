Cell[CellGroupData[{

Cell["Receiver-resonant transformer", "Chapter",
 CellChangeTimes->{{3.963466150815741*^9, 3.9634661543809834`*^9}, {
  3.963466288330284*^9, 
  3.963466291727446*^9}},ExpressionUUID->"7a3e96e8-72ee-4491-b72c-\
570b4855e00b"],

Cell["\<\
Putting C in parallel with L at the secondary, to create a resonant receiver. \
Without receiver resistance, we\[CloseCurlyQuote]d get an ideal resonator.\
\>", "Text",
 CellChangeTimes->{{3.963466293612549*^9, 3.963466335077351*^9}, 
   3.963486563720563*^9, {3.963486833484138*^9, 3.9634868442082157`*^9}, {
   3.963487697435104*^9, 
   3.963487713740823*^9}},ExpressionUUID->"868e80eb-4abf-44d2-8d3a-\
ee2ef673d8c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"V1", "==", 
        RowBox[{
         RowBox[{"R", " ", "I1"}], "+", 
         RowBox[{"s", " ", "L", " ", "I1"}], "+", 
         RowBox[{"s", " ", "L", " ", "I2"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"0", "==", 
        RowBox[{
         RowBox[{"R", " ", "I2"}], "+", 
         RowBox[{"s", " ", "L", " ", "I1"}], "+", 
         RowBox[{"s", " ", "L", " ", "I2"}], " ", "+", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"s", " ", "C"}]], "I2"}]}]}]}], "\[IndentingNewLine]", 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"V1", ",", " ", "I2"}], "}"}]}], "]"}], "//", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"#", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L", ",", "I1", ",", "R", ",", "\[Omega]", ",", "C"}], "}"}], 
       "\[Element]", "PositiveReals"}]}], "]"}], "&"}]}]}]], "Input",
 CellChangeTimes->{{3.963477662969432*^9, 3.963477674015636*^9}, {
   3.963486591920615*^9, 3.963486620941183*^9}, {3.963486667534789*^9, 
   3.963486744111772*^9}, 3.9634868287576447`*^9, 3.9634868831555557`*^9, 
   3.963486982806683*^9, {3.9634872665313387`*^9, 3.963487267303618*^9}, {
   3.963487336716055*^9, 3.963487338849619*^9}, {3.963487433902474*^9, 
   3.9634874439371862`*^9}, {3.963487686874358*^9, 3.963487689635556*^9}, {
   3.963487739377552*^9, 3.963487739907907*^9}},
 CellLabel->"In[94]:=",ExpressionUUID->"0dd68bb0-7fe6-47e7-9fb5-5a6b86a220ae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"V1", "\[Rule]", 
     FractionBox[
      RowBox[{"I1", " ", 
       RowBox[{"(", 
        RowBox[{"R", "+", 
         RowBox[{"L", " ", "s"}], "+", 
         RowBox[{"C", " ", "R", " ", "s", " ", 
          RowBox[{"(", 
           RowBox[{"R", "+", 
            RowBox[{"2", " ", "L", " ", "s"}]}], ")"}]}]}], ")"}]}], 
      RowBox[{"1", "+", 
       RowBox[{"C", " ", "s", " ", 
        RowBox[{"(", 
         RowBox[{"R", "+", 
          RowBox[{"L", " ", "s"}]}], ")"}]}]}]]}], ",", 
    RowBox[{"I2", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"C", " ", "I1", " ", "L", " ", 
        SuperscriptBox["s", "2"]}], 
       RowBox[{"1", "+", 
        RowBox[{"C", " ", "s", " ", 
         RowBox[{"(", 
          RowBox[{"R", "+", 
           RowBox[{"L", " ", "s"}]}], ")"}]}]}]]}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.963486707742937*^9, 3.9634867530431757`*^9}, 
   3.963486829108972*^9, 3.963486883773941*^9, 3.963486983920051*^9, 
   3.963487267926573*^9, 3.963487348262185*^9, 3.9634874447008753`*^9, 
   3.963487690401455*^9, 3.963487740344516*^9},
 CellLabel->"Out[94]=",ExpressionUUID->"08ec0c56-3fd9-4a66-acce-f0839ac3ea89"]
}, Open  ]],

Cell["We measure across the capacitor:", "Text",
 CellChangeTimes->{{3.9634869277022457`*^9, 
  3.963486936360899*^9}},ExpressionUUID->"5fd46ff1-9694-4a5d-a97d-\
dedbae8f6444"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"V2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"I2", " ", 
      FractionBox["1", 
       RowBox[{"s", " ", "C"}]]}], "/.", "sol"}], "/.", 
    RowBox[{"C", "->", 
     FractionBox["1", 
      RowBox[{"L", " ", 
       SuperscriptBox["\[Omega]0", "2"]}]]}]}], "/.", 
   RowBox[{"s", "->", 
    RowBox[{"I", " ", "\[Omega]"}]}]}]}]], "Input",
 CellChangeTimes->{
  3.9634869264221897`*^9, {3.963486987967536*^9, 3.963486990567425*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"6faf2692-f135-4c94-8d90-5447ac2573d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"-", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", "I1", " ", "L", " ", "\[Omega]"}], 
    RowBox[{"1", "+", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
       RowBox[{"(", 
        RowBox[{"R", "+", 
         RowBox[{"\[ImaginaryI]", " ", "L", " ", "\[Omega]"}]}], ")"}]}], 
      RowBox[{"L", " ", 
       SuperscriptBox["\[Omega]0", "2"]}]]}]]}], "}"}]], "Output",
 CellChangeTimes->{
  3.963486786945013*^9, 3.96348685052658*^9, 3.963486891249847*^9, 
   3.963486937450025*^9, 3.963486995700597*^9, 3.963487271241432*^9, 
   3.963487351118976*^9, 3.9634874485299377`*^9, {3.9634876926896*^9, 
   3.963487718978771*^9}},
 CellLabel->"Out[90]=",ExpressionUUID->"00605c20-2c8f-4c19-8b53-1a21ae6d3849"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Abs", "[", "V2", "]"}], "]"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "L", ",", "R", ",", "I1", ",", "\[Omega]", ",", "\[Omega]0", ",", "C"}], 
     "}"}], "\[Element]", "PositiveReals"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9634777257690353`*^9, 3.96347772601064*^9}, {
   3.963477803679145*^9, 3.9634778043686867`*^9}, {3.9634867833831797`*^9, 
   3.9634867850886717`*^9}, 3.963487110030264*^9, {3.963487294744748*^9, 
   3.9634872967658157`*^9}, {3.963487743276709*^9, 3.963487743774982*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"8ce84897-e99e-46c8-b461-c7108adfa9cb"],

Cell[BoxData[
 RowBox[{"{", 
  FractionBox[
   RowBox[{"I1", " ", "L", " ", "\[Omega]"}], 
   SqrtBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        FractionBox[
         SuperscriptBox["\[Omega]", "2"], 
         SuperscriptBox["\[Omega]0", "2"]]}], ")"}], "2"], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["R", "2"], " ", 
       SuperscriptBox["\[Omega]", "2"]}], 
      RowBox[{
       SuperscriptBox["L", "2"], " ", 
       SuperscriptBox["\[Omega]0", "4"]}]]}]]], "}"}]], "Output",
 CellChangeTimes->{{3.963477696545973*^9, 3.963477726377336*^9}, 
   3.9634778048621683`*^9, 3.9634867812576103`*^9, 3.963486854753749*^9, 
   3.963486892919524*^9, 3.963486944778429*^9, 3.9634869978737307`*^9, {
   3.963487283520265*^9, 3.9634872993269577`*^9}, 3.963487354608345*^9, 
   3.96348745106424*^9, {3.963487720881544*^9, 3.9634877443301487`*^9}},
 CellLabel->"Out[95]=",ExpressionUUID->"5e2ee9cf-1706-4507-9056-388e10772c84"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox[
    RowBox[{"I1", " ", "L", " ", "\[Omega]"}], 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         FractionBox[
          SuperscriptBox["\[Omega]", "2"], 
          SuperscriptBox["\[Omega]0", "2"]]}], ")"}], "2"], "+", 
