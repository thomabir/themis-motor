 FractionBox[
  RowBox[{"L", " ", "Vi", " ", "\[Omega]"}], 
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"L", " ", "\[Omega]"}], "+", 
