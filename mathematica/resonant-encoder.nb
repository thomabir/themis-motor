Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Vo", " ", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"C", " ", "R", " ", "s"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"C", " ", "s", " ", 
         RowBox[{"(", 
          RowBox[{"R", "+", 
           RowBox[{"2", " ", "L", " ", "s"}]}], ")"}]}]}], ")"}]}], 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["C", "2"]}], " ", 
      SuperscriptBox["L", "2"], " ", 
      SuperscriptBox["s", "4"]}]]}], "==", " ", "Vi"}], ";"}]], "Input",
 CellChangeTimes->{{3.945424287032672*^9, 3.945424346363986*^9}},
 CellLabel->
  "In[138]:=",ExpressionUUID->"e5d24343-3bc9-45a7-ae55-933b17d406d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"C", " ", "R", " ", "s"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"C", " ", "s", " ", 
        RowBox[{"(", 
         RowBox[{"R", "+", 
          RowBox[{"2", " ", "L", " ", "s"}]}], ")"}]}]}], ")"}]}], 
    RowBox[{
     RowBox[{"-", 
