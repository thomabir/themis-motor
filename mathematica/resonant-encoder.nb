      RowBox[{"(", 
       RowBox[{"R1", "+", "R2"}], ")"}], "2"], " ", 
     SuperscriptBox["\[Omega]", "2"]}]}]], "}"}]], "Output",
 CellChangeTimes->{{3.963449325234798*^9, 3.963449348704702*^9}},
 CellLabel->"Out[13]=",ExpressionUUID->"27ad63bf-f474-4d4b-b789-54c220feb60e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Limit", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"R1", " ", 
      SuperscriptBox["V0", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["R2", "2"], "+", 
        RowBox[{
         SuperscriptBox["L", "2"], " ", 
         SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}], 
     RowBox[{
      RowBox[{
       SuperscriptBox["R1", "2"], " ", 
