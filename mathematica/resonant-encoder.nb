 CellLabel->"In[98]:=",ExpressionUUID->"95b8be11-4f64-4636-8784-fa1aeed4248b"],

Cell[BoxData[
 FractionBox[
  RowBox[{"I1", " ", 
   SuperscriptBox["L", "2"], " ", 
   SuperscriptBox["\[Omega]0", "2"]}], "R"]], "Output",
 CellChangeTimes->{
  3.963487034907425*^9, 3.963487365150058*^9, {3.963487458001732*^9, 
   3.963487465163599*^9}, {3.963487556328609*^9, 3.963487562684312*^9}, {
