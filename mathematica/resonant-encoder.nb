Cell[TextData[{
 "What is the frequency we should aim for? Gain \[TildeTilde] ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SqrtBox["2"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a7a0fa0-effa-40f4-8dda-b521b986bf54"],
 ","
}], "Text",
 CellChangeTimes->{{3.9634484558938723`*^9, 3.963448507632587*^9}, {
  3.963448975536456*^9, 3.9634489791101637`*^9}, {3.963449021064089*^9, 
  3.963449038706403*^9}},ExpressionUUID->"256778e5-40bf-4dd0-8d9a-\
754fd7fef9ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"L", " ", "\[Omega]"}], 
     SqrtBox[
      RowBox[{
       SuperscriptBox["R1", "2"], "+", 
       RowBox[{
        SuperscriptBox["L", "2"], " ", 
        SuperscriptBox["\[Omega]", "2"]}]}]]], "==", 
    FractionBox["1", 
     SqrtBox["2"]]}], ",", "\[Omega]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9634489850663147`*^9, 3.963449009260107*^9}, {
  3.963449042116969*^9, 3.963449044542045*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"2dec9684-9cca-452a-b546-f4b56c04b7c7"],

Cell[BoxData[
 TemplateBox[{
  "Solve", "nongen", 
   "\"There may be values of the parameters for which some or all solutions \
are not valid.\"", 2, 11, 2, 27799136658952558794, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellChangeTimes->{3.963449045031069*^9},
