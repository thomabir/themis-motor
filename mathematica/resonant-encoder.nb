Cell["\<\
For 1V and 1\[CapitalOmega], that\[CloseCurlyQuote]s 500 mW, quite some \
power! But manageable I think. If we make the trace longer, R1 goes up and \
the power goes down, without any loss in gain.\
\>", "Text",
 CellChangeTimes->{{3.9634494384403954`*^9, 3.963449487738578*^9}, {
  3.963449564893937*^9, 
  3.9634495838580112`*^9}},ExpressionUUID->"16e3c3aa-2159-49bf-9bf5-\
06f84d2615e0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Current source on primary", "Chapter",
 CellChangeTimes->{{3.963462463400107*^9, 
  3.963462468024151*^9}},ExpressionUUID->"19a767b7-cfd9-4d8b-8991-\
dda74166ae37"],

Cell["\<\
How to modify the equation? It\[CloseCurlyQuote]s the same model, but I1 is \
now given, and V1 is unknown (it\[CloseCurlyQuote]s the voltage that the \
current source puts out)
Assumptions: ideal coupling of two coils with inductance L and ESR R. \
Receiver measures voltage drop across resistor R2, with the limit R2->inf\
\>", "Text",
 CellChangeTimes->{{3.963462478712329*^9, 3.963462524905262*^9}, {
  3.96346255769734*^9, 3.963462566275352*^9}, {3.963575237877516*^9, 
  3.963575286844995*^9}},ExpressionUUID->"23e1bde2-cde8-4e5c-ba86-\
990b4d1a05de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"V1", "==", 
       RowBox[{
        RowBox[{"R", " ", "I1"}], "+", 
        RowBox[{"s", " ", "L", " ", "I1"}], "+", 
        RowBox[{"s", " ", "L", " ", "I2"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"0", "==", 
       RowBox[{
        RowBox[{"R", " ", "I2"}], "+", 
        RowBox[{"s", " ", "L", " ", "I2"}], "+", 
        RowBox[{"s", " ", "L", " ", "I1"}], "+", 
        RowBox[{"R2", " ", "I2"}]}]}]}], "\[IndentingNewLine]", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"V1", ",", " ", "I2"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.963462523071741*^9, 3.9634625287928057`*^9}, {
  3.963567563585664*^9, 3.9635675687975082`*^9}, {3.96357078287153*^9, 
  3.96357079906771*^9}, {3.963570882225657*^9, 3.963570888471583*^9}, {
  3.963571608790229*^9, 3.963571615805933*^9}},
 CellLabel->
  "In[134]:=",ExpressionUUID->"d93e69e3-a19c-4469-a807-231eb597765c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"V1", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "I1"}], " ", 
         SuperscriptBox["R", "2"]}], "-", 
        RowBox[{"I1", " ", "R", " ", "R2"}], "-", 
        RowBox[{"2", " ", "I1", " ", "L", " ", "R", " ", "s"}], "-", 
        RowBox[{"I1", " ", "L", " ", "R2", " ", "s"}]}], 
       RowBox[{"R", "+", "R2", "+", 
        RowBox[{"L", " ", "s"}]}]]}]}], ",", 
    RowBox[{"I2", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"I1", " ", "L", " ", "s"}], 
       RowBox[{"R", "+", "R2", "+", 
        RowBox[{"L", " ", "s"}]}]]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{
  3.963462529380067*^9, {3.9635675643704767`*^9, 3.963567569109383*^9}, 
   3.963570753263692*^9, 3.963571580575514*^9, 3.963571619696615*^9},
 CellLabel->
  "Out[134]=",ExpressionUUID->"c440f04e-07b9-4c38-b4e1-f7254029e284"]
}, Open  ]],

Cell["Voltage across R2:", "Text",
 CellChangeTimes->{{3.963575370023632*^9, 
  3.9635753738419952`*^9}},ExpressionUUID->"806a1bcc-0aad-4098-8ffe-\
d1dfe49be101"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"V2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"I2", " ", "R2"}], "/.", 
     RowBox[{"sol", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
    RowBox[{"s", "->", 
     RowBox[{"I", " ", "\[Omega]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"V2abs", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"Abs", "[", "V2", "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "L", ",", "I1", ",", "R", ",", "R2", ",", "V0", ",", "\[Omega]"}], 
      "}"}], "\[Element]", "PositiveReals"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9634625755946703`*^9, 3.963462611721835*^9}, {
  3.963570813710931*^9, 3.9635708195442133`*^9}, {3.963570894871998*^9, 
  3.963570895203785*^9}, {3.9635716292057657`*^9, 3.963571643359934*^9}, {
  3.9635753062674427`*^9, 3.963575340858235*^9}},
 CellLabel->
  "In[179]:=",ExpressionUUID->"56f5d977-17b7-4dff-bbb2-d98deed83126"],

Cell[BoxData[
 FractionBox[
  RowBox[{"I1", " ", "L", " ", "R2", " ", "\[Omega]"}], 
  SqrtBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"R", "+", "R2"}], ")"}], "2"], "+", 
    RowBox[{
     SuperscriptBox["L", "2"], " ", 
     SuperscriptBox["\[Omega]", "2"]}]}]]]], "Output",
 CellChangeTimes->{{3.963462595144814*^9, 3.96346261197171*^9}, 
   3.9635715916510973`*^9, {3.963571624656233*^9, 3.9635716439646797`*^9}, {
   3.963575307614785*^9, 3.963575341132221*^9}, 3.963575385218185*^9, 
   3.963575536375411*^9},
 CellLabel->
  "Out[180]=",ExpressionUUID->"1fe04611-2ffa-47da-b674-d486cfcf6ca5"]
}, Open  ]],

Cell["Limit for large resistance:", "Text",
 CellChangeTimes->{{3.963462624787409*^9, 
  3.9634626302648697`*^9}},ExpressionUUID->"c90f4d05-4925-4493-a396-\
90f54444c950"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"V2abs", "=", 
  RowBox[{
   RowBox[{"Limit", "[", 
    RowBox[{"V2abs", ",", 
     RowBox[{"R2", "->", "\[Infinity]"}]}], "]"}], "//", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"#", ",", 
      RowBox[{"I1", ">", "0"}]}], "]"}], "&"}]}]}]], "Input",
