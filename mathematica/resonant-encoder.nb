 RowBox[{"\[CapitalDelta]\[Omega]", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Omega]2", "-", "\[Omega]1"}], "/.", "sol\[Omega]"}], "//", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
