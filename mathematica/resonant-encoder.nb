Cell[CellGroupData[{

Cell["Q factor", "Section",
 CellChangeTimes->{{3.945424059107479*^9, 
  3.945424060800518*^9}},ExpressionUUID->"734dc845-965b-4d98-b280-\
1ff641f41234"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"V0", "==", 
         RowBox[{
          FractionBox["I1", 
           RowBox[{"s", " ", "C"}]], "+", 
          RowBox[{"s", " ", "L", " ", "I1"}], "+", 
          RowBox[{"s", " ", "M", " ", "I2"}], "+", 
          RowBox[{"R", " ", "I1"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"0", "==", 
         RowBox[{
          FractionBox["I2", 
           RowBox[{"s", " ", "C"}]], "+", 
          RowBox[{"s", " ", "L", " ", "I2"}], "+", 
          RowBox[{"s", " ", "M", " ", "I1"}], "+", 
          RowBox[{"R", " ", "I2"}]}]}]}], "\[IndentingNewLine]", "}"}], "/.", 
      
      RowBox[{"M", "->", "L"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"I1", ",", " ", "I2"}], "}"}]}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.945424064210832*^9, {3.9454245278982973`*^9, 3.945424564124894*^9}, {
   3.9454245967153463`*^9, 3.945424601867839*^9}, {3.945424638283161*^9, 
   3.945424666926456*^9}, {3.945424774117152*^9, 3.945424774385365*^9}, {
   3.945425245882484*^9, 3.945425246203079*^9}},
 CellLabel->
  "In[154]:=",ExpressionUUID->"3f406ed8-4b35-468f-b1a5-51f7e18c451a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"I1", "\[Rule]", 
    FractionBox[
     RowBox[{"C", " ", "s", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"C", " ", "R", " ", "s"}], "+", 
        RowBox[{"C", " ", "L", " ", 
         SuperscriptBox["s", "2"]}]}], ")"}], " ", "V0"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"C", " ", "R", " ", "s"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"C", " ", "R", " ", "s"}], "+", 
        RowBox[{"2", " ", "C", " ", "L", " ", 
         SuperscriptBox["s", "2"]}]}], ")"}]}]]}], ",", 
   RowBox[{"I2", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["C", "2"], " ", "L", " ", 
       SuperscriptBox["s", "3"], " ", "V0"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"C", " ", "R", " ", "s"}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"C", " ", "R", " ", "s"}], "+", 
         RowBox[{"2", " ", "C", " ", "L", " ", 
          SuperscriptBox["s", "2"]}]}], ")"}]}]]}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.945424641467609*^9, 3.945424675304179*^9, 
  3.9454247746357737`*^9, 3.9454252465068197`*^9},
 CellLabel->
  "Out[154]=",ExpressionUUID->"fe34a219-0400-4b0e-a239-9992f933164d"]
}, Open  ]],

