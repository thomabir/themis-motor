Cell["\<\
So, assuming L and R are both linearly dependent on geometry, that leaves us \
with:\[LineSeparator]- increase \[Omega] as much as possible
- From a purely thermal efficiency perspective, decrease I1 (misleading I \
think)\
\>", "Text",
 CellChangeTimes->{{3.963466073757162*^9, 3.963466129483047*^9}, 
   3.963575417401822*^9},ExpressionUUID->"1068042f-c5e8-4645-9508-\
0613e66e3811"],

Cell["\<\
Realistically, go with the highest reasonable input power, the output voltage \
will be\
\>", "Text",
 CellChangeTimes->{{3.9635676452706347`*^9, 
  3.963567672314286*^9}},ExpressionUUID->"178accc1-b792-4d20-b0b5-\
f6d8c96eb3b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"V2abs", "/.", 
   RowBox[{"I1", "->", 
    SqrtBox[
     RowBox[{"P", "/", "R"}]]}]}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.963567695917148*^9, 3.963567714999954*^9}, {
   3.96357546067412*^9, 3.963575461998889*^9}, 3.963575698792165*^9},
 CellLabel->
  "In[186]:=",ExpressionUUID->"541c2268-99f5-4718-86d9-155bcf7bab1e"],

Cell[BoxData[
 RowBox[{"L", " ", 
  SqrtBox[
   FractionBox["P", "R"]], " ", "\[Omega]"}]], "Output",
 CellChangeTimes->{3.963567715258894*^9, 3.963575467045623*^9, 
  3.963575699264783*^9},
 CellLabel->
  "Out[186]=",ExpressionUUID->"6f74b173-143e-41dd-bda6-0b096bd1880c"]
}, Open  ]],

Cell["\<\
So, adjusting L and \[Omega] has a much larger effect on output voltage than \
adjusting current or resistance.\[AliasDelimiter]\
\>", "Text",
 CellChangeTimes->{{3.9635677231667843`*^9, 3.963567739456719*^9}, 
   3.963570615982053*^9},ExpressionUUID->"84a0709d-6fa8-4fb9-b1f9-\
e037a8287390"],

Cell["Voltage needed to produce the desired current:", "Text",
 CellChangeTimes->{{3.9635707421952972`*^9, 3.963570745320725*^9}, {
  3.963575485921077*^9, 
  3.963575496726893*^9}},ExpressionUUID->"7caf9d83-b6cb-4eeb-8749-\
0054da6f3eee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"V1abs", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"V1", "/.", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
       RowBox[{"s", "->", 
        RowBox[{"I", " ", "\[Omega]"}]}]}], "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "L", ",", "I1", ",", "R", ",", "R2", ",", "V0", ",", "\[Omega]"}], 
      "}"}], "\[Element]", "PositiveReals"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.963570749114492*^9, 3.9635707623864603`*^9}, {
   3.963575480236081*^9, 3.963575532297442*^9}, 3.963575577464167*^9},
 CellLabel->
  "In[184]:=",ExpressionUUID->"26209fdf-cb5c-405a-b79e-eb6ab58d6acb"],

Cell[BoxData[
 RowBox[{"I1", " ", 
  SqrtBox[
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["R", "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"R", "+", "R2"}], ")"}], "2"]}], "+", 
     RowBox[{
      SuperscriptBox["L", "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "R"}], "+", "R2"}], ")"}], "2"], " ", 
      SuperscriptBox["\[Omega]", "2"]}]}], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"R", "+", "R2"}], ")"}], "2"], "+", 
     RowBox[{
      SuperscriptBox["L", "2"], " ", 
      SuperscriptBox["\[Omega]", "2"]}]}]]]}]], "Output",
 CellChangeTimes->{{3.963575478549796*^9, 3.963575481382069*^9}, {
   3.963575515451277*^9, 3.9635755403491993`*^9}, 3.963575578716551*^9},
 CellLabel->
  "Out[184]=",ExpressionUUID->"23bb9ffa-3845-40bd-8026-9c36270c3959"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"V1abs", "=", 
  RowBox[{
   RowBox[{"Limit", "[", 
    RowBox[{"V1abs", ",", 
     RowBox[{"R2", "->", "\[Infinity]"}]}], "]"}], "//", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"#", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "L", ",", "I1", ",", "R", ",", "R2", ",", "V0", ",", "\[Omega]"}], 
        "}"}], "\[Element]", "PositiveReals"}]}], "]"}], "&"}]}]}]], "Input",
 CellChangeTimes->{{3.963575542634488*^9, 3.963575561418412*^9}, {
  3.963575594104869*^9, 3.963575603422763*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"8874c181-c4ba-4ca9-84ce-6f05ac4c0157"],

Cell[BoxData[
 RowBox[{"I1", " ", 
  SqrtBox[
   RowBox[{
    SuperscriptBox["R", "2"], "+", 
    RowBox[{
     SuperscriptBox["L", "2"], " ", 
     SuperscriptBox["\[Omega]", "2"]}]}]]}]], "Output",
 CellChangeTimes->{3.963575606132516*^9},
 CellLabel->
  "Out[185]=",ExpressionUUID->"b3d0092c-afc1-4e0a-8cdb-7f2d1c43682b"]
}, Open  ]],

Cell["The voltage required for a given thermal power is thus", "Text",
