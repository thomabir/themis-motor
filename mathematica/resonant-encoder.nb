 CellLabel->"In[8]:=",ExpressionUUID->"d0d4ccea-76cc-48ae-976d-83613046216b"],

Cell[BoxData[
 FractionBox[
  RowBox[{"L", " ", "V0", " ", "\[Omega]"}], 
  SqrtBox[
   RowBox[{
    SuperscriptBox["R1", "2"], "+", 
    RowBox[{
     SuperscriptBox["L", "2"], " ", 
     SuperscriptBox["\[Omega]", "2"]}]}]]]], "Output",
