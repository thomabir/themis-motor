Notebook[{

Cell[CellGroupData[{
Cell[TextData[StyleBox["Mathematical model for two coupled loops of wire", \
"Chapter"]], "Subtitle",
 CellChangeTimes->{{3.9435409688609037`*^9, 3.943540974686124*^9}, {
  3.943669589755742*^9, 3.943669596992083*^9}, {3.943670473753129*^9, 
  3.943670484610527*^9}},ExpressionUUID->"1063a756-caa9-4b05-b8ac-\
a92c715cc736"],

Cell[TextData[{
 "For two coupled inductors with 100% coupling efficiency, we have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            SubscriptBox[
             StyleBox["L", "TI"], "1"], 
            SubscriptBox[
             StyleBox["L", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> "M=\\sqrt{L_1 L_2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "290c569b-7ddb-46f2-a3f5-035ffbf3a27c"],
 ". We have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], "1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["L", "TI"], "2"], "\[LongEqual]", 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "L_1 = L_2 = L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e9c1a09-23f5-4368-9b47-aa293459435d"],
 ", as both loops have the same geometry, thus ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", 
         StyleBox["L", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M=L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b8eb396c-4955-4982-9b40-fa060fbefee2"],
 ".\nThe circuit is then modelled by the following coupled linear system of \
ODEs:"
}], "Text",
 CellChangeTimes->{{3.9436693710326843`*^9, 3.9436693937462597`*^9}, {
  3.94366943749389*^9, 3.943669494778492*^9}, {3.9436695275807877`*^9, 
  3.9436695647593193`*^9}, {3.943669728549016*^9, 3.943669732382011*^9}, {
  3.9436703286151047`*^9, 
  3.943670330212833*^9}},ExpressionUUID->"42aded3d-ed59-4a1f-bb7f-\
af4e4ee92906"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sys", "=", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"V0", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Omega]", " ", "t"}], "]"}]}], "==", 
      RowBox[{
       RowBox[{"R1", " ", 
        RowBox[{"I1", "[", "t", "]"}]}], "+", 
       RowBox[{"L", " ", 
        RowBox[{
         RowBox[{"I1", "'"}], "[", "t", "]"}]}], "+", 
       RowBox[{"M", " ", 
        RowBox[{
         RowBox[{"I2", "'"}], "[", "t", "]"}]}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"0", "==", 
      RowBox[{
       RowBox[{"R2", " ", 
        RowBox[{"I2", "[", "t", "]"}]}], "+", 
       RowBox[{"L", " ", 
        RowBox[{
         RowBox[{"I2", "'"}], "[", "t", "]"}]}], "+", 
       RowBox[{"M", " ", 
        RowBox[{
         RowBox[{"I1", "'"}], "[", "t", "]"}]}]}]}]}], "\[IndentingNewLine]", 
    "}"}], "/.", 
   RowBox[{"M", "->", "L"}]}]}]], "Input",
 CellChangeTimes->{{3.9436694975143633`*^9, 3.943669518313843*^9}, {
  3.943669566573587*^9, 3.943669571783712*^9}, {3.963448171072117*^9, 
  3.963448172302093*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"f4d1159e-7c30-4ed6-a28f-8b7fddc3b0ac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"V0", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"t", " ", "\[Omega]"}], "]"}]}], "\[Equal]", 
    RowBox[{
     RowBox[{"R1", " ", 
      RowBox[{"I1", "[", "t", "]"}]}], "+", 
     RowBox[{"L", " ", 
      RowBox[{
       SuperscriptBox["I1", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}], "+", 
     RowBox[{"L", " ", 
      RowBox[{
       SuperscriptBox["I2", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}]}]}], ",", 
   RowBox[{"0", "\[Equal]", 
    RowBox[{
     RowBox[{"R2", " ", 
      RowBox[{"I2", "[", "t", "]"}]}], "+", 
     RowBox[{"L", " ", 
      RowBox[{
       SuperscriptBox["I1", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}], "+", 
     RowBox[{"L", " ", 
      RowBox[{
       SuperscriptBox["I2", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.943669572365006*^9, {3.945344975033963*^9, 3.945344993822235*^9}, 
   3.945345046519618*^9, {3.9634481728752623`*^9, 3.963448202199894*^9}},
 CellLabel->"Out[1]=",ExpressionUUID->"3dde7c22-28d0-438b-848a-cdce3cb8ddb5"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["V", "TI"], "0"], "sin", 
         RowBox[{"(", 
           RowBox[{"\[Omega]", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "V_0 \\sin(\\omega t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "70c37dee-c056-484a-a86f-be16cd0c52ce"],
 " is the source on the primary here, and on the secondary we measure the \
voltage drop across ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "R_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ba1a104-861d-4566-98c5-bbe62bb10161"],
 " with a voltmeter.\nCan\[CloseCurlyQuote]t solve it straight away:"
}], "Text",
 CellChangeTimes->{{3.943669609913018*^9, 3.943669619379183*^9}, {
  3.9436697488658257`*^9, 
  3.9436698145775013`*^9}},ExpressionUUID->"74a7bda0-c9f7-4544-88a5-\
cd3e74d6517b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{"sys", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"I1", "[", "t", "]"}], ",", 
     RowBox[{"I2", "[", "t", "]"}]}], "}"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.943540977115893*^9, 3.94354109760393*^9}, {
  3.943541324695043*^9, 3.9435414019881687`*^9}, {3.943541487248948*^9, 
  3.9435415208704567`*^9}, {3.9435415867190847`*^9, 3.943541594293071*^9}, {
  3.943669358364002*^9, 3.943669359155448*^9}, {3.9436696243789997`*^9, 
  3.943669628251915*^9}, {3.945344965953187*^9, 3.945345004807514*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"dfea5be7-f8fe-4539-8f0e-7f6fcdf39298"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"I1", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      FractionBox[
       RowBox[{"V0", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"t", " ", "\[Omega]"}], "]"}]}], 
       RowBox[{"R1", "+", "R2"}]], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           SuperscriptBox["L", "2"], " ", "R1", " ", "R2"}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"L", " ", "R1"}], "+", 
             RowBox[{"L", " ", "R2"}], "+", 
             RowBox[{"R1", " ", "R2"}]}], ")"}], "2"]], "+", 
         FractionBox[
          RowBox[{
           SuperscriptBox["L", "2"], " ", 
           SuperscriptBox["R2", "2"]}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"L", " ", "R1"}], "+", 
             RowBox[{"L", " ", "R2"}], "+", 
             RowBox[{"R1", " ", "R2"}]}], ")"}], "2"]]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"R1", " ", "R2", " ", "t"}], 
             RowBox[{"L", " ", 
              RowBox[{"(", 
               RowBox[{"R1", "+", "R2"}], ")"}]}]]}]], " ", 
          TemplateBox[{"1"},
           "C"]}], "-", 
         FractionBox[
          RowBox[{"R2", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"R1", " ", "R2"}], "+", 
              RowBox[{"L", " ", 
               RowBox[{"(", 
                RowBox[{"R1", "+", "R2"}], ")"}]}]}], ")"}], "2"], " ", "V0", 
           " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"L", " ", 
              RowBox[{"(", 
               RowBox[{"R1", "+", "R2"}], ")"}], " ", "\[Omega]", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"t", " ", "\[Omega]"}], "]"}]}], "-", 
             RowBox[{"R1", " ", "R2", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"t", " ", "\[Omega]"}], "]"}]}]}], ")"}]}], 
          RowBox[{
           SuperscriptBox["L", "2"], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"R1", "+", "R2"}], ")"}], "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "\[ImaginaryI]"}], " ", "R1", " ", "R2"}], "+", 
             RowBox[{"L", " ", "R1", " ", "\[Omega]"}], "+", 
             RowBox[{"L", " ", "R2", " ", "\[Omega]"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "R1", " ", "R2"}], "+", 
             RowBox[{"L", " ", "R1", " ", "\[Omega]"}], "+", 
             RowBox[{"L", " ", "R2", " ", "\[Omega]"}]}], ")"}]}]]}], 
        ")"}]}]}]}], ",", 
    RowBox[{
     RowBox[{"I2", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"V0", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"t", " ", "\[Omega]"}], "]"}]}], 
        RowBox[{"R1", "+", "R2"}]]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           SuperscriptBox["L", "2"], " ", 
           SuperscriptBox["R1", "2"]}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"L", " ", "R1"}], "+", 
             RowBox[{"L", " ", "R2"}], "+", 
             RowBox[{"R1", " ", "R2"}]}], ")"}], "2"]], "+", 
         FractionBox[
          RowBox[{
           SuperscriptBox["L", "2"], " ", "R1", " ", "R2"}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"L", " ", "R1"}], "+", 
             RowBox[{"L", " ", "R2"}], "+", 
             RowBox[{"R1", " ", "R2"}]}], ")"}], "2"]]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"R1", " ", "R2", " ", "t"}], 
             RowBox[{"L", " ", 
              RowBox[{"(", 
               RowBox[{"R1", "+", "R2"}], ")"}]}]]}]], " ", 
          TemplateBox[{"1"},
           "C"]}], "-", 
         FractionBox[
          RowBox[{"R2", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"R1", " ", "R2"}], "+", 
              RowBox[{"L", " ", 
               RowBox[{"(", 
                RowBox[{"R1", "+", "R2"}], ")"}]}]}], ")"}], "2"], " ", "V0", 
           " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"L", " ", 
              RowBox[{"(", 
               RowBox[{"R1", "+", "R2"}], ")"}], " ", "\[Omega]", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"t", " ", "\[Omega]"}], "]"}]}], "-", 
             RowBox[{"R1", " ", "R2", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"t", " ", "\[Omega]"}], "]"}]}]}], ")"}]}], 
          RowBox[{
           SuperscriptBox["L", "2"], " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"R1", "+", "R2"}], ")"}], "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "\[ImaginaryI]"}], " ", "R1", " ", "R2"}], "+", 
             RowBox[{"L", " ", "R1", " ", "\[Omega]"}], "+", 
             RowBox[{"L", " ", "R2", " ", "\[Omega]"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "R1", " ", "R2"}], "+", 
             RowBox[{"L", " ", "R1", " ", "\[Omega]"}], "+", 
             RowBox[{"L", " ", "R2", " ", "\[Omega]"}]}], ")"}]}]]}], 
        ")"}]}]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{
  3.943669631999325*^9, {3.945344970321356*^9, 3.9453450052351027`*^9}, 
   3.945345051816002*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"753d38f9-d629-4498-bc0d-920a722fefae"]
}, Open  ]],

Cell[TextData[{
 "Instead, we turn the system of linear ODEs into a system of linear \
equations by going to the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26fa6c94-af34-4027-b8f2-c7e329d2fd89"],
 "-domain, where solving it is easier:"
}], "Text",
 CellChangeTimes->{{3.943669658107534*^9, 
  3.9436696980469723`*^9}},ExpressionUUID->"fdca7a05-af65-4deb-bd67-\
5d4759e76fd9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"V0", "==", 
       RowBox[{
        RowBox[{"R1", " ", "I1"}], "+", 
        RowBox[{"s", " ", "L", " ", "I1"}], "+", 
        RowBox[{"s", " ", "L", " ", "I2"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"0", "==", 
       RowBox[{
        RowBox[{"R2", " ", "I2"}], "+", 
        RowBox[{"s", " ", "L", " ", "I2"}], "+", 
        RowBox[{"s", " ", "L", " ", "I1"}]}]}]}], "\[IndentingNewLine]", 
     "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"I1", ",", " ", "I2"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.943542882590953*^9, 3.943542946463965*^9}, {
  3.943544847981324*^9, 3.943544890091927*^9}, {3.943669714508506*^9, 
  3.943669722930498*^9}, {3.943669835781176*^9, 3.943669853242539*^9}, {
  3.943669890662346*^9, 3.943669906511506*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"98ab95d4-c469-4cb5-882f-4182cfaeddef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"I1", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"R2", "+", 
         RowBox[{"L", " ", "s"}]}], ")"}], " ", "V0"}], 
      RowBox[{
       RowBox[{"R1", " ", "R2"}], "+", 
       RowBox[{"L", " ", "R1", " ", "s"}], "+", 
       RowBox[{"L", " ", "R2", " ", "s"}]}]]}], ",", 
    RowBox[{"I2", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"L", " ", "s", " ", "V0"}], 
       RowBox[{
        RowBox[{"R1", " ", "R2"}], "+", 
        RowBox[{"L", " ", "R1", " ", "s"}], "+", 
        RowBox[{"L", " ", "R2", " ", "s"}]}]]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9435441138748198`*^9, 3.9435448517465763`*^9, {3.943544883429727*^9, 
   3.9435448906300573`*^9}, {3.943669895700645*^9, 3.943669907376301*^9}, 
   3.9634482279747343`*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"3d27845e-ea1b-46a5-86fd-f23756f6be19"]
}, Open  ]],

Cell[TextData[{
 "Now, to find the voltage ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["V", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "V_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c71dbc8b-3fce-4470-9ae7-1f925b5c82d6"],
 " measured across ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "R_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26bd4da4-3bce-4816-9473-eb9892ee7d71"],
 ", use Ohm\[CloseCurlyQuote]s law with the solution we just found, and plug \
in for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "76fdf3fe-64e9-4451-a203-fea46ba0a829"],
 ":"
}], "Text",
 CellChangeTimes->{{3.943669912865355*^9, 3.943669983600968*^9}, {
  3.943670170773695*^9, 
  3.943670171591989*^9}},ExpressionUUID->"c867dcf6-22a3-4e7f-8fbd-\
75e9cccb2869"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"V2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"I2", " ", "R2"}], "/.", "sol"}], "/.", 
   RowBox[{"s", "->", 
    RowBox[{"I", " ", "\[Omega]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9435436082290583`*^9, 3.943543627863693*^9}, {
  3.943544134895155*^9, 3.9435441537678833`*^9}, {3.943544859519188*^9, 
  3.943544863320859*^9}, {3.9435448990866127`*^9, 3.943544923751952*^9}, {
  3.943669956933056*^9, 3.943669968812282*^9}, {3.963448248952139*^9, 
  3.9634482502633467`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"dcc5b61c-1cb8-44dc-980e-682fcd5767fd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"-", 
   FractionBox[
    RowBox[{
    "\[ImaginaryI]", " ", "L", " ", "R2", " ", "V0", " ", "\[Omega]"}], 
    RowBox[{
     RowBox[{"R1", " ", "R2"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", "L", " ", "R1", " ", "\[Omega]"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", "L", " ", "R2", " ", "\[Omega]"}]}]]}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.9436699691256523`*^9, {3.963448238706026*^9, 3.9634482511028633`*^9}},
 CellLabel->"Out[4]=",ExpressionUUID->"27a6a757-8d30-4d3b-adc1-709b7e4de6c8"]
}, Open  ]],

Cell["We care only about amplitude, not about phase:", "Text",
 CellChangeTimes->{{3.94367000771141*^9, 
  3.943670034569611*^9}},ExpressionUUID->"707816d2-9cb7-49f3-8999-\
61c9b73e6f7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Abs", "[", "V2", "]"}], "]"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"L", ",", "R1", ",", "R2", ",", "V0", ",", "\[Omega]"}], "}"}], 
    "\[Element]", "PositiveReals"}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.943543645234398*^9, 3.9435441592496767`*^9, {3.943544905026393*^9, 
   3.943544940700882*^9}, 3.9436700405850477`*^9, {3.963448268353867*^9, 
   3.963448268752757*^9}, {3.963448351557926*^9, 3.963448378884501*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"eb2b595e-e33b-4ae5-8e85-580096da7ee0"],

Cell[BoxData[
 RowBox[{"{", 
  FractionBox[
   RowBox[{"L", " ", "R2", " ", "V0", " ", "\[Omega]"}], 
   SqrtBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["R1", "2"], " ", 
      SuperscriptBox["R2", "2"]}], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"L", " ", "R1", " ", "\[Omega]"}], "+", 
        RowBox[{"L", " ", "R2", " ", "\[Omega]"}]}], ")"}], "2"]}]]], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.943543646068535*^9, 3.943544159900157*^9, 3.9435449059925222`*^9, 
   3.9435449410888042`*^9, 3.9436700420786753`*^9, 3.963448269252287*^9, {
   3.9634483751000013`*^9, 3.9634483791759768`*^9}},
 CellLabel->"Out[7]=",ExpressionUUID->"931fce9a-4288-4e1d-8ba5-113e0b2d7fb8"]
}, Open  ]],

Cell[TextData[{
 "In practice, we can make the input impedance of the voltmeter quite large, \
so we can simplify by going to the limit ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], "2"], "\[Rule]", "\[Infinity]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "R_2 \\to \\infty", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d93b5574-2b25-4148-a2ec-de52cd6a9dd5"],
 ":"
}], "Text",
 CellChangeTimes->{{3.943670049040695*^9, 
  3.943670089366254*^9}},ExpressionUUID->"667e2d9f-8603-4941-a370-\
77b0a914c449"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Limit", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"L", " ", "R2", " ", "V0", " ", "\[Omega]"}], 
     SqrtBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["R1", "2"], " ", 
        SuperscriptBox["R2", "2"]}], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"L", " ", "R1", " ", "\[Omega]"}], "+", 
          RowBox[{"L", " ", "R2", " ", "\[Omega]"}]}], ")"}], "2"]}]]], ",", 
    RowBox[{"R2", "->", "\[Infinity]"}]}], "]"}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.943544173215239*^9, 3.943544180518445*^9}, {
   3.94354494843114*^9, 3.943544951496071*^9}, {3.943545325428211*^9, 
