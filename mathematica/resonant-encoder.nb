Cell[TextData[{
 "Find where gain is reduced by ",
 Cell[BoxData[
  FormBox[
   SqrtBox["2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "04ee7177-643d-4d2a-98b4-4d256cab8019"],
 ":"
}], "Text",
 CellChangeTimes->{{3.945426223897171*^9, 
  3.945426247762796*^9}},ExpressionUUID->"e1af2f45-5de4-40d6-bcad-\
e76b274d3a4d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["AbsV2", "2"], "==", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["V0", 
      SqrtBox[
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{"C", " ", 
             SuperscriptBox["R", "2"]}], "L"]}], ")"}], "2"]}]]], ")"}], 
    "2"]}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.945426257830825*^9, 3.945426341531451*^9}},
 CellLabel->
  "In[168]:=",ExpressionUUID->"5f589569-d0a1-40ba-a630-53269bbc3932"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    SuperscriptBox["C", "4"], " ", 
    SuperscriptBox["L", "4"], " ", 
    SuperscriptBox["V0", "2"], " ", 
    SuperscriptBox["\[Omega]", "8"]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       SuperscriptBox["C", "2"], " ", 
       SuperscriptBox["R", "2"], " ", 
       SuperscriptBox["\[Omega]", "2"]}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["C", "2"], " ", 
       SuperscriptBox["R", "2"], " ", 
       SuperscriptBox["\[Omega]", "2"]}], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", "C", " ", "L", " ", 
          SuperscriptBox["\[Omega]", "2"]}]}], ")"}], "2"]}], ")"}]}]], 
  "\[Equal]", 
  FractionBox[
   RowBox[{
    SuperscriptBox["L", "2"], " ", 
    SuperscriptBox["V0", "2"]}], 
   RowBox[{"2", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"L", "+", 
       RowBox[{"C", " ", 
        SuperscriptBox["R", "2"]}]}], ")"}], "2"]}]]}]], "Output",
 CellChangeTimes->{{3.9454262714562883`*^9, 3.94542634201223*^9}},
 CellLabel->
  "Out[168]=",ExpressionUUID->"feebfa0f-e652-42a5-91bb-b222029d6eb3"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"2", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"L", "+", 
       RowBox[{"C", " ", 
        SuperscriptBox["R", "2"]}]}], ")"}], "2"], 
    SuperscriptBox["C", "4"], " ", 
    SuperscriptBox["L", "4"], " ", 
    SuperscriptBox["V0", "2"], " ", 
    SuperscriptBox["\[Omega]", "8"]}], "\[Equal]", 
   RowBox[{
    SuperscriptBox["L", "2"], " ", 
    SuperscriptBox["V0", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       SuperscriptBox["C", "2"], " ", 
       SuperscriptBox["R", "2"], " ", 
       SuperscriptBox["\[Omega]", "2"]}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["C", "2"], " ", 
       SuperscriptBox["R", "2"], " ", 
       SuperscriptBox["\[Omega]", "2"]}], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", "C", " ", "L", " ", 
          SuperscriptBox["\[Omega]", "2"]}]}], ")"}], "2"]}], ")"}]}]}], "//",
   "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9454263713237677`*^9, 3.945426406183879*^9}},
 CellLabel->
  "In[170]:=",ExpressionUUID->"8f08eb7c-44af-474d-b4f7-4bda4dda32d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", 
   SuperscriptBox["C", "4"], " ", 
   SuperscriptBox["L", "4"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"L", "+", 
      RowBox[{"C", " ", 
       SuperscriptBox["R", "2"]}]}], ")"}], "2"], " ", 
   SuperscriptBox["V0", "2"], " ", 
   SuperscriptBox["\[Omega]", "8"]}], "\[Equal]", 
  RowBox[{
