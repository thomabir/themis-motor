Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", 
    RowBox[{
     SuperscriptBox["C", "2"], " ", 
     SuperscriptBox["L", "2"], " ", 
     SuperscriptBox["\[Omega]", "4"]}]]}], "-", 
  FractionBox[
   RowBox[{"2", " ", "\[ImaginaryI]", " ", "R"}], 
