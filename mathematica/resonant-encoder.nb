Cell[TextData[{
 "The transformer equation is recovered when the frequency is high enough for \
the impedance of the inductor to dominate the impedance of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], "1"], TraditionalForm], "errors" -> {}, "input" -> 
     "R_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6483579a-a743-4791-a46d-bcb32d59f193"],
 ":"
}], "Text",
 CellChangeTimes->{{3.943670109847168*^9, 3.943670153467051*^9}, {
  3.943670257535359*^9, 
