Cell["Plugging in the gain point:", "Text",
 CellChangeTimes->{{3.963449393092001*^9, 
  3.963449418414077*^9}},ExpressionUUID->"a0b55160-0886-47f9-a48e-\
c678dc59bc72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox[
    RowBox[{"R1", " ", 
     SuperscriptBox["V0", "2"]}], 
    RowBox[{
     SuperscriptBox["R1", "2"], "+", 
     RowBox[{
      SuperscriptBox["L", "2"], " ", 
      SuperscriptBox["\[Omega]", "2"]}]}]], "/.", 
