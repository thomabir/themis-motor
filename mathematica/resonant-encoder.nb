In[11]:=",ExpressionUUID->"ffd08d5a-d5e9-47ff-9075-a8770b97f56c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Omega]", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["R1", "L"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Omega]", "\[Rule]", 
     FractionBox["R1", "L"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9634489986980343`*^9, 3.963449010892064*^9}, 
   3.9634490450427094`*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"7208357b-eea5-41c3-b921-8bd7a3f21d1d"]
}, Open  ]],

Cell["\<\
For 1\[CapitalOmega] + 1\[Micro]H, that\[CloseCurlyQuote]s f = 2\[Pi]\[Omega] \
= 6 MHz. Making the trace longer should increase both inductance and \
resistance linearly, so the recommended frequency will be pretty constant.\
\>", "Text",
 CellChangeTimes->{{3.9634490717472887`*^9, 3.9634490842928247`*^9}, {
  3.963449519732295*^9, 3.9634495562588043`*^9}, {3.963462373959648*^9, 
  3.963462393134094*^9}},ExpressionUUID->"a014ae14-a602-4e6a-94e8-\
bca0b255566f"],

Cell["\<\
How much worse is it if we\[CloseCurlyQuote]re at one tenth of this frequency?\
\>", "Text",
 CellChangeTimes->{{3.9634496053524027`*^9, 
  3.9634496168786793`*^9}},ExpressionUUID->"912a31a2-0a39-46a8-98d6-\
d659a20a75b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox[
    RowBox[{"L", " ", "\[Omega]"}], 
    SqrtBox[
     RowBox[{
      SuperscriptBox["R1", "2"], "+", 
      RowBox[{
       SuperscriptBox["L", "2"], " ", 
       SuperscriptBox["\[Omega]", "2"]}]}]]], "/.", 
   RowBox[{"\[Omega]", "->", 
    FractionBox["R1", 
     RowBox[{"10", "L"}]]}]}], "//", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{"R1", ">", "0"}]}], "]"}], "&"}]}]], "Input",
 CellChangeTimes->{{3.963449630613514*^9, 3.963449678777524*^9}, {
  3.963461448623719*^9, 3.963461461856162*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"e0056b2f-f10e-4853-8608-81e241fd881f"],

Cell[BoxData[
 FractionBox["1", 
  SqrtBox["101"]]], "Output",
 CellChangeTimes->{
  3.963449631048875*^9, {3.963449674011327*^9, 3.963449679086994*^9}, {
   3.9634614549724083`*^9, 3.963461462113422*^9}},
 CellLabel->"Out[21]=",ExpressionUUID->"079d2c88-0298-49df-ba4d-4dfaa9c49f6c"]
}, Open  ]],

Cell[TextData[{
 "The gain is then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1732f358-a690-4e39-8f60-4ff2c7de720e"],
 " as well, so we lose 20 dB of SNR, assuming equal noise in the receiver."
}], "Text",
 CellChangeTimes->{{3.963449686815524*^9, 
  3.9634497321794357`*^9}},ExpressionUUID->"c5ccdc78-485d-4144-909d-\
c0c728c0fa73"],

Cell["\<\
At the same time, I want to reduce heat dissipation in the sender, which is\
\>", "Text",
 CellChangeTimes->{{3.963449254403327*^9, 
  3.9634492678445673`*^9}},ExpressionUUID->"9fa60858-b81b-46ec-b71f-\
9af812de666d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["I1", "2"], " ", "R1"}], "/.", "sol"}], "/.", 
      RowBox[{"s", "->", 
       RowBox[{"I", " ", "\[Omega]"}]}]}], "]"}], "]"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"L", ",", "R1", ",", "R2", ",", "V0", ",", "\[Omega]"}], "}"}], 
    "\[Element]", "PositiveReals"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9634492895537443`*^9, 3.963449292260572*^9}, {
  3.9634493237445908`*^9, 3.963449346865796*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"4925c115-0718-4e53-96f2-8f5858b1f886"],

Cell[BoxData[
 RowBox[{"{", 
  FractionBox[
   RowBox[{"R1", " ", 
    SuperscriptBox["V0", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["R2", "2"], "+", 
      RowBox[{
       SuperscriptBox["L", "2"], " ", 
       SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}], 
   RowBox[{
    RowBox[{
     SuperscriptBox["R1", "2"], " ", 
     SuperscriptBox["R2", "2"]}], "+", 
    RowBox[{
