  3.963575672593388*^9}},ExpressionUUID->"26979dc4-878b-49e9-ab8c-\
55a0640c4002"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"V1abs", "/.", 
   RowBox[{"I1", "->", 
    SqrtBox[
     FractionBox["P", "R"]]}]}], "//", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "P", ",", "L", ",", "I1", ",", "R", ",", "R2", ",", "V0", ",", 
        "\[Omega]"}], "}"}], "\[Element]", "PositiveReals"}]}], "]"}], 
   "&"}]}]], "Input",
