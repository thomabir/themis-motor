   SuperscriptBox["\[Omega]", "4"]}], 
  SqrtBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       SuperscriptBox["C", "2"], " ", 
       SuperscriptBox["R", "2"], " ", 
