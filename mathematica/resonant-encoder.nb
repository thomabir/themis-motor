Cell[CellGroupData[{

Cell["\<\
Single resonant transformer, C but no extra L, measure across C\
\>", "Chapter",
 CellChangeTimes->{{3.945435621619874*^9, 3.945435644150147*^9}, {
  3.9454356919824142`*^9, 
  3.945435697265685*^9}},ExpressionUUID->"1119d9e8-67bc-43f6-b7aa-\
a616610a733d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Vi", "==", 
          RowBox[{
           RowBox[{"s", " ", "L", " ", "I1"}], "+", 
           RowBox[{"s", " ", "M", " ", "I2"}], "+", 
           RowBox[{"R", " ", "I1"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"0", "==", 
          RowBox[{
           FractionBox["I2", 
            RowBox[{"s", " ", "C"}]], "+", 
           RowBox[{"s", " ", "L", " ", "I2"}], "+", 
           RowBox[{"s", " ", "M", " ", "I1"}], "+", 
           RowBox[{"R", " ", "I2"}]}]}]}], "\[IndentingNewLine]", "}"}], "/.", 
       RowBox[{"M", "->", "L"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"I1", ",", " ", "I2"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Vo", "=", 
   RowBox[{
    RowBox[{
     FractionBox["I2", 
      RowBox[{"s", " ", "C"}]], "/.", "sol"}], "/.", 
    RowBox[{"s", "->", 
     RowBox[{"I", " ", "\[Omega]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"AbsVo", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"Abs", "[", "Vo", "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"L", ",", "C", ",", "R", ",", "\[Omega]", ",", "Vi"}], "}"}], 
     "\[Element]", "PositiveReals"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Vores", "=", 
  RowBox[{
   RowBox[{"AbsVo", "/.", 
    RowBox[{"\[Omega]", "->", 
     FractionBox["1", 
      SqrtBox[
       RowBox[{"2", "L", " ", "C"}]]]}]}], "//", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{"#", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "L", ",", "L2", ",", "C", ",", "R", ",", "\[Omega]", ",", "Vi"}], 
        "}"}], "\[Element]", "PositiveReals"}]}], "]"}], "&"}]}]}]}], "Input",\

 CellChangeTimes->{{3.945435651618436*^9, 3.945435710370599*^9}, {
