Cell["\<\
That\[CloseCurlyQuote]s a fourth order system, it doesn\[CloseCurlyQuote]t \
have a Q factor in the strict definition. But we could estimate the bandwidth \
\[CapitalDelta]\[Omega] of the peak:\
\>", "Text",
 CellChangeTimes->{{3.945424815500106*^9, 3.945424819317492*^9}, {
  3.945426000170678*^9, 
  3.945426055654574*^9}},ExpressionUUID->"87212ea1-24e6-4966-925e-\
c97f1b0291f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"V2sol", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"I2", "  ", "L", " ", "s"}], "/.", "sol"}], "/.", 
    RowBox[{"s", "->", 
     RowBox[{"I", " ", "\[Omega]"}]}]}], "//", "FullSimplify"}]}]], "Input",
 CellChangeTimes->{{3.945426080158222*^9, 3.945426084385441*^9}, {
  3.9454261286548986`*^9, 3.9454261305360107`*^9}},
 CellLabel->
  "In[157]:=",ExpressionUUID->"9d6aa941-9760-47c8-9b10-82001c184449"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["C", "2"], " ", 
    SuperscriptBox["L", "2"], " ", "V0", " ", 
    SuperscriptBox["\[Omega]", "4"]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"\[ImaginaryI]", " ", "C", " ", "R", " ", "\[Omega]"}]}], ")"}],
     " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"C", " ", "\[Omega]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "R"}], "-", 
         RowBox[{"2", " ", "L", " ", "\[Omega]"}]}], ")"}]}]}], 
     ")"}]}]]}]], "Output",
 CellChangeTimes->{3.945426085002001*^9, 3.945426131712816*^9},
 CellLabel->
  "Out[157]=",ExpressionUUID->"8d213e5e-f772-4fa9-9d4c-e73081606ec5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsV2", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"Abs", "[", "V2sol", "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "L", ",", "L2", ",", "C", ",", "R", ",", "\[Omega]", ",", "V0"}], "}"}],
      "\[Element]", "PositiveReals"}]}], "]"}]}]], "Input",
 CellLabel->
