Cell["\<\
This is a stronger rotation than if only one sender has a phase shift. The \
phase error at the source goes directly into phase error at the measurement.\
\>", "Text",
 CellChangeTimes->{{3.963313583647509*^9, 
  3.963313609613283*^9}},ExpressionUUID->"3ec495e7-762c-4b67-aba9-\
555680e83fc7"]
}, Open  ]],

