Notebook[{

Cell[CellGroupData[{
Cell["Dual-frequency inductive encoder", "Title",
 CellChangeTimes->{{3.9629451426719313`*^9, 3.962945148323358*^9}, {
   3.962960729575192*^9, 3.9629607304484386`*^9}, {3.963329853084591*^9, 
   3.963329853241538*^9}, {3.963401754626831*^9, 3.963401761118204*^9}, 
   3.9699349582712107`*^9},ExpressionUUID->"0fc2f81a-1b25-4160-9e37-\
97b4a3a36606"],

Cell[CellGroupData[{

Cell["Concept", "Chapter",
 CellChangeTimes->{{3.969934988719701*^9, 
  3.9699349917927933`*^9}},ExpressionUUID->"1ef1d230-020f-4b28-8660-\
42d0b1e75594"],

Cell["We send out two signals from the transmitter:", "Text",
 CellChangeTimes->{{3.963314206103354*^9, 
  3.963314221235443*^9}},ExpressionUUID->"c52378fe-f4d3-446f-b64b-\
1481b4dc12c4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"TX1", "=", 
   RowBox[{"a1", " ", 
    StyleBox[
     RowBox[{"Sin", "[", 
      RowBox[{"\[Omega]1", " ", "t"}], "]"}],
     FontSize->14]}]}], 
  StyleBox[";",
   FontSize->14]}], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"TX2", "=", 
    RowBox[{"a2", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"\[Omega]2", " ", "t"}], "]"}]}]}], ";"}],
  FontSize->14]}], "Input",
 CellChangeTimes->{{3.963314224266221*^9, 3.963314268778043*^9}},
 CellLabel->
  "In[116]:=",ExpressionUUID->"fbbab38f-4d9a-4413-83bc-1e64a6766c25"],

Cell["They may have arbitrary phase and amplitude.", "Text",
 CellChangeTimes->{{3.9633142704091167`*^9, 3.963314338756212*^9}, {
   3.963329872732757*^9, 3.963329879443235*^9}, 
   3.974019677645433*^9},ExpressionUUID->"1ea87aa6-a26a-4a1d-a09e-\
547dceaab946"],

Cell["\<\
Idea : There is no relevant phase information at all, it' s all encoded in \
amplitude of the signals (which may have drifts and gain errors) and in the \
frequency of the signals (which is resilient against most drifts, even in a \
nonlinear system) (maybe not clock frequency drifts)\
\>", "Text",
 CellChangeTimes->{{3.963315850663986*^9, 
  3.963315851844933*^9}},ExpressionUUID->"a92addc8-e878-488e-b063-\
26eda163181a"],

Cell["\<\
We send these two into the sin and cos sender coils of the inductive encoder. \
Depending on the rotor angle, TX1 and TX2 will couple into the two receive \
windings RX1 and RX2:\
\>", "Text",
 CellChangeTimes->{{3.963314348101781*^9, 
  3.963314400184195*^9}},ExpressionUUID->"a108c909-896b-4f3b-b02c-\
11c65cbb933f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"RX1", "=", 
  RowBox[{"g1", 
   RowBox[{"(", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", "\[Phi]", "]"}], 
      StyleBox["TX1",
       FontSize->14]}], 
     StyleBox["+",
      FontSize->14], 
     StyleBox[
      RowBox[{
       RowBox[{"Cos", "[", "\[Phi]", "]"}], "TX2"}],
      FontSize->14]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"RX2", "=", 
  RowBox[{"g2", 
   RowBox[{"(", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", "\[Phi]", "]"}], 
      StyleBox["TX1",
       FontSize->14]}], 
     StyleBox["+",
      FontSize->14], 
     StyleBox[
      RowBox[{
       RowBox[{"Sin", "[", "\[Phi]", "]"}], "TX2"}],
      FontSize->14]}], ")"}]}]}]}], "Input",
 CellChangeTimes->{{3.963314409742466*^9, 3.963314471789323*^9}, {
  3.963315307431368*^9, 3.963315308404875*^9}, {3.963359525772398*^9, 
  3.963359528748611*^9}, {3.963359600180779*^9, 3.963359603408574*^9}, {
  3.9633614231472597`*^9, 3.963361427737727*^9}, {3.963361709433579*^9, 
  3.9633617148353777`*^9}},
 CellLabel->
  "In[250]:=",ExpressionUUID->"d7a588da-8d94-4aa6-a3a9-03d0640a415e"],

Cell[BoxData[
 RowBox[{"g1", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"a1", " ", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"t", " ", "\[Omega]1"}], "]"}]}], "+", 
    RowBox[{"a2", " ", 
     RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"t", " ", "\[Omega]2"}], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{
  3.963315309046397*^9, 3.96335960456079*^9, 3.9633614297048893`*^9, {
   3.963361712690826*^9, 3.963361715458542*^9}},
 CellLabel->
  "Out[250]=",ExpressionUUID->"f63edb15-a925-4426-a752-d15ce896c25e"],

Cell[BoxData[
 RowBox[{"g2", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"a1", " ", 
     RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"t", " ", "\[Omega]1"}], "]"}]}], "+", 
    RowBox[{"a2", " ", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"t", " ", "\[Omega]2"}], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{
  3.963315309046397*^9, 3.96335960456079*^9, 3.9633614297048893`*^9, {
   3.963361712690826*^9, 3.963361715460376*^9}},
 CellLabel->
  "Out[251]=",ExpressionUUID->"b0d94127-8f25-41c0-b4a7-1f6e7c61cf83"]
}, Open  ]],

Cell["\<\
Each receiver may again have an arbitrary gain error or phase error, g1 and \
g2.\
\>", "Text",
 CellChangeTimes->{{3.963314416124833*^9, 3.963314419939445*^9}, {
  3.963314453849442*^9, 
  3.9633144649105797`*^9}},ExpressionUUID->"972124d0-1ec5-4e4b-bb9b-\
718acda6b860"],

Cell[TextData[{
 "Now, we demodulate each RX signal with the two known frequency references, \
so we get four signals. We use an IQ demodulator, and we use ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{
     SuperscriptBox["I", "2"], "+", 
     SuperscriptBox["Q", "2"]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "47ac0a41-3945-4089-945d-f3269d248120"],
 ", such that the phase of the original signal or the reference are \
irrelevant."
}], "Text",
 CellChangeTimes->{{3.9633144760193977`*^9, 3.963314521448327*^9}, {
  3.9633146167173777`*^9, 3.9633146775043383`*^9}, {3.963315418653371*^9, 
  3.9633154346868*^9}},ExpressionUUID->"a4258037-34f9-4d63-bb96-580520780586"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"R11", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"g1", " ", "a1"}], "]"}], " ", 
    RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], 
  StyleBox[";",
   FontSize->14]}], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"R12", "=", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"g1", " ", "a2"}], "]"}], " ", 
     RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ";"}],
  FontSize->14], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   StyleBox["R21",
    FontSize->14], 
   StyleBox["=",
    FontSize->14], 
   RowBox[{
    RowBox[{
     StyleBox["Abs",
      FontSize->14], 
     StyleBox["[",
      FontSize->14], 
     RowBox[{"g2", " ", "a1"}], "]"}], " ", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], 
  StyleBox[";",
   FontSize->14]}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox[
   RowBox[{"R22", "=", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"g2", " ", "a2"}], "]"}], " ", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}],
   FontSize->14], ";"}]}], "Input",
 CellChangeTimes->{{3.945336165005948*^9, 3.9453362136948833`*^9}, {
   3.945336341063046*^9, 3.945336341799807*^9}, {3.94533796169061*^9, 
   3.945337961815072*^9}, 3.9633144034576073`*^9, 3.9633145236911583`*^9, {
   3.963315441103723*^9, 3.963315464634656*^9}, {3.963315602180142*^9, 
   3.963315605566739*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"40e2b3a3-ff6b-48e3-8c2e-c08ab1f7ae05"],

Cell["\<\
Four equations, five unknowns. But the phase \[Phi] can be retrieved \
independent of the unknown gains.\
\>", "Text",
 CellChangeTimes->{{3.963314541835102*^9, 3.963314576292115*^9}, {
  3.9633146868791437`*^9, 3.9633146919422283`*^9}, {3.963315392042212*^9, 
  3.963315416278178*^9}, {3.963315579960662*^9, 3.963315580251734*^9}, {
  3.963315818105755*^9, 3.963315830783049*^9}, {3.963360468877468*^9, 
  3.963360478003866*^9}},ExpressionUUID->"6082835b-6ad4-43a7-ae17-\
91f3f5f8c8dc"],

Cell["We get the I and Q components like this:", "Text",
 CellChangeTimes->{{3.963314709843882*^9, 3.9633147228612127`*^9}, {
   3.963315903209923*^9, 3.9633159093129377`*^9}, 
   3.9633299554439783`*^9},ExpressionUUID->"5d3f5d54-2ff0-46c7-b809-\
8e783f8150ec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Sign", "[", "R11", "]"}], 
   SqrtBox[
    RowBox[{"R11", "*", "R22"}]]}], "//", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a1", ",", "g1", ",", "a2", ",", "g2"}], "}"}], "\[Element]", 
       "PositiveReals"}], "&&", 
      RowBox[{"\[Phi]", "\[Element]", "Reals"}]}]}], "]"}], 
   "&"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Sign", "[", "R12", "]"}], 
   SqrtBox[
    RowBox[{"R12", "*", "R21"}]]}], "//", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a1", ",", "g1", ",", "a2", ",", "g2"}], "}"}], "\[Element]", 
       "PositiveReals"}], "&&", 
      RowBox[{"\[Phi]", "\[Element]", "Reals"}]}]}], "]"}], "&"}]}]}], "Input",\

 CellChangeTimes->{{3.963313971448213*^9, 3.963314093080402*^9}, {
  3.9633147369591703`*^9, 3.963314746262341*^9}, {3.96331565784099*^9, 
  3.9633156690555058`*^9}, {3.963315744044365*^9, 3.963315765844944*^9}, {
  3.9633158020085783`*^9, 3.963315802102413*^9}},
 CellLabel->
  "In[173]:=",ExpressionUUID->"2dcb798e-e539-4173-b47a-d7afd6913494"],

Cell[BoxData[
 RowBox[{
  SqrtBox[
   RowBox[{"a1", " ", "a2", " ", "g1", " ", "g2"}]], " ", 
  RowBox[{"Sin", "[", "\[Phi]", "]"}]}]], "Output",
 CellChangeTimes->{{3.963313973392499*^9, 3.9633140933363543`*^9}, {
   3.963314742226523*^9, 3.963314747146797*^9}, 3.963315479779571*^9, {
   3.963315661786057*^9, 3.963315669433866*^9}, {3.9633157542295313`*^9, 
   3.9633157663643093`*^9}, 3.963315802508713*^9},
 CellLabel->
  "Out[173]=",ExpressionUUID->"66afc77c-b0e6-4bda-987a-cc110c9c45fa"],

Cell[BoxData[
 RowBox[{
  SqrtBox[
   RowBox[{"a1", " ", "a2", " ", "g1", " ", "g2"}]], " ", 
  RowBox[{"Cos", "[", "\[Phi]", "]"}]}]], "Output",
 CellChangeTimes->{{3.963313973392499*^9, 3.9633140933363543`*^9}, {
   3.963314742226523*^9, 3.963314747146797*^9}, 3.963315479779571*^9, {
   3.963315661786057*^9, 3.963315669433866*^9}, {3.9633157542295313`*^9, 
   3.9633157663643093`*^9}, 3.9633158025156317`*^9},
 CellLabel->
  "Out[174]=",ExpressionUUID->"a35ef897-588e-437b-8d5f-c66659b43f76"]
}, Open  ]],

Cell["\<\
(There are multiple ways to get them, this is just one possible way)\
\>", "Text",
 CellChangeTimes->{{3.9633158085235233`*^9, 3.963315814641457*^9}, {
  3.963315912270453*^9, 
  3.963315917336892*^9}},ExpressionUUID->"8c8d15ef-0fee-4c6d-b534-\
0596c0c0b8bf"],

Cell["\<\
Put them in a Cordic, and you\[CloseCurlyQuote]re done. Since both I and Q \
have the same prefactor, there is no dependence on a1, a2, g1, or g2.\
\>", "Text",
 CellChangeTimes->{{3.963315919818973*^9, 
  3.963315946526889*^9}},ExpressionUUID->"2188cb41-98d7-4f6c-8610-\
a5f15d357e72"],

Cell["\<\
No need for ellipse correction, temperature stabilisation, recalibration etc. \
It seems to be a very resilient method.\
\>", "Text",
 CellChangeTimes->{{3.963315953583637*^9, 
  3.9633159841707563`*^9}},ExpressionUUID->"135a8acb-5400-4ef3-a729-\
0289401744a0"],

Cell[TextData[{
 "\nAssuming an external DDS for the TX:\n\[LineSeparator]",
 StyleBox["Per input sample (64 kS/s):",
  FontWeight->"Bold"],
 "\[LineSeparator]- 2 16-bit ADC readings (DMA)\n- 4 16-bit int lookups \
(sin/cos for \[Omega]1/\[Omega]2)\[LineSeparator]- 8 multiplications (16 bit \
int * 16 bit int -> 16 bit int, each reading with each of the 4 lookups)\
\[LineSeparator]- 8 low-passes to get I and Q for each of the four R channels\
\[LineSeparator]\t(per IIR: about 4 MACs approx, maybe 8 MACs?)\
\[AliasDelimiter]\[LineSeparator]\t(could also use a basic running average, \
or CIC decimator, (pipelined) which would also take care of downsampling. \
Needs an FIR compensator if flat gain is desired)\[LineSeparator]\
\[LineSeparator]",
 StyleBox["Per output reading (1 kS/s)",
  FontWeight->"Bold"],
 ":\[LineSeparator]- 4 ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{
     SuperscriptBox["I", "2"], "+", 
     SuperscriptBox["Q", "2"]}]], TraditionalForm]],ExpressionUUID->
  "8c52a420-a213-4876-9339-d3075e1f4ea3"],
 "to get the amplitudes for each R channel\[LineSeparator]- 2 \
multiplications, 2 signs, 2 sqrts to get final I and Q\[LineSeparator]- 1 \
atan2 to get phi from I and Q\n\nFor an absolute reading, consider using an \
independent mechanism for dissimilar redundancy (optical, capacitive etc.), \
or a simple inductive encoder (Renesas etc.)"
}], "Text",
 CellChangeTimes->{{3.963316003811184*^9, 3.9633162330744343`*^9}, {
   3.963316327157889*^9, 3.963316373056628*^9}, {3.963316415428576*^9, 
   3.963316524582809*^9}, {3.96331664065482*^9, 3.963316673041389*^9}, {
   3.963317491061706*^9, 3.963317509800921*^9}, {3.9633179905712852`*^9, 
   3.963318000707818*^9}, {3.9633180326238337`*^9, 3.963318033482506*^9}, {
   3.9634021402172956`*^9, 3.963402224125805*^9}, {3.9634026559890537`*^9, 
   3.9634026566984177`*^9}, {3.963403165268969*^9, 3.9634032839820013`*^9}, 
   3.963403350111948*^9, {3.974020012384165*^9, 3.974020048878327*^9}, {
   3.9740200852462873`*^9, 
   3.9740202169010067`*^9}},ExpressionUUID->"244a58cc-65cb-47b4-89cc-\
e1f69fc285f8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ellipse errors", "Chapter",
 CellChangeTimes->{{3.963359672311784*^9, 
  3.9633596770503283`*^9}},ExpressionUUID->"870f8a21-a077-4775-9f5b-\
5fd7e93855fe"],

Cell["\<\
If the four signals each have arbitrary real gains, an ellipse correction is \
necessary. It has to be repeated whenever one gain changes independently from \
the others. Phase errors still don\[CloseCurlyQuote]t \
matter.\[LineSeparator]This drift cannot happen electronically as far as I \
can see, it could happen if the coupling coefficients between the coils \
change. (It could also happen from having different gains for the different \
frequencies in a single amplifier stage. Since they are quite close together, \
this seems unlikely.)\
\>", "Text",
 CellChangeTimes->{{3.963359681170536*^9, 3.9633597179004498`*^9}, {
  3.96335985305212*^9, 3.963359895946602*^9}, {3.963361797021316*^9, 
  3.963361804620224*^9}, {3.96336197148934*^9, 3.963362064026381*^9}, {
  3.969934767440542*^9, 3.969934779612191*^9}, {3.9743670343024683`*^9, 
  3.9743670758541193`*^9}},ExpressionUUID->"cd39738d-7db6-4aea-94ac-\
b722578dfb75"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"R11", "=", 
   RowBox[{"g11", " ", 
    RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], 
  StyleBox[";",
   FontSize->14]}], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"R12", "=", 
    RowBox[{"g12", " ", 
     RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ";"}],
  FontSize->14], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   StyleBox["R21",
    FontSize->14], 
   StyleBox["=",
    FontSize->14], 
   RowBox[{"g21", " ", 
    RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], 
  StyleBox[";",
   FontSize->14]}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox[
   RowBox[{"R22", "=", 
    RowBox[{"g22", " ", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}],
   FontSize->14], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Sign", "[", "R11", "]"}], 
   SqrtBox[
    RowBox[{"R11", "*", "R22"}]]}], "//", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g11", ",", "g12", ",", "g21", ",", "g22"}], "}"}], 
       "\[Element]", "PositiveReals"}], "&&", 
      RowBox[{"\[Phi]", "\[Element]", "Reals"}]}]}], "]"}], 
   "&"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Sign", "[", "R12", "]"}], 
   SqrtBox[
    RowBox[{"R12", "*", "R21"}]]}], "//", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g11", ",", "g12", ",", "g21", ",", "g22"}], "}"}], 
       "\[Element]", "PositiveReals"}], "&&", 
      RowBox[{"\[Phi]", "\[Element]", "Reals"}]}]}], "]"}], "&"}]}]}], "Input",\

 CellChangeTimes->{{3.963359697123745*^9, 3.963359769037238*^9}, {
  3.963359982829475*^9, 3.963360075781465*^9}, {3.9633602451631527`*^9, 
  3.96336024720385*^9}, {3.963362469466926*^9, 3.9633624723692904`*^9}},
 CellLabel->
  "In[260]:=",ExpressionUUID->"add5a813-d890-488c-bb3b-5b038879bf28"],

Cell[BoxData[
 RowBox[{
  SqrtBox[
   RowBox[{"g11", " ", "g22"}]], " ", 
  RowBox[{"Sin", "[", "\[Phi]", "]"}]}]], "Output",
 CellChangeTimes->{{3.963359746769689*^9, 3.963359769810322*^9}, {
   3.963359987610674*^9, 3.963360076335042*^9}, 3.9633602479078836`*^9, 
   3.963362472826632*^9},
 CellLabel->
  "Out[264]=",ExpressionUUID->"5b200b94-ac66-4793-a9b5-0c45ee8950c7"],

Cell[BoxData[
 RowBox[{
  SqrtBox[
   RowBox[{"g12", " ", "g21"}]], " ", 
  RowBox[{"Cos", "[", "\[Phi]", "]"}]}]], "Output",
 CellChangeTimes->{{3.963359746769689*^9, 3.963359769810322*^9}, {
   3.963359987610674*^9, 3.963360076335042*^9}, 3.9633602479078836`*^9, 
   3.963362472847457*^9},
 CellLabel->
  "Out[265]=",ExpressionUUID->"9a7e1b76-3467-401e-be6e-e3502f41bc95"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"R11", "*", "R22", "*", "R12", "*", "R21"}], "//", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{"#", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g11", ",", "g12", ",", "g21", ",", "g22"}], "}"}], 
       "\[Element]", "PositiveReals"}], "&&", 
      RowBox[{"\[Phi]", "\[Element]", "Reals"}]}]}], "]"}], "&"}]}]], "Input",\

 CellChangeTimes->{{3.96336029165893*^9, 3.963360359086904*^9}, {
