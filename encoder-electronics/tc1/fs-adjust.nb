}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ItotN", "=", 
  RowBox[{
   RowBox[{"18", "Itot"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"R1", "->", "1500"}], ",", 
     RowBox[{"R2", "->", "1000"}], ",", 
     RowBox[{"R3", "->", "6800"}], ",", 
     RowBox[{"Vfs", "->", "1.15"}], ",", 
