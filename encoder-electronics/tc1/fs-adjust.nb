Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"eqs", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Vpwm", "==", 
      RowBox[{
       RowBox[{"I2", " ", "R2"}], "-", 
       RowBox[{"I1", " ", "R1"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Vfs", "==", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"I1", "+", "I2"}], ")"}], "R3"}], "+", 
       RowBox[{"I2", " ", "R2"}]}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{"eqs", ",", 
     RowBox[{"{", 
      RowBox[{"I1", ",", "I2"}], "}"}]}], "]"}], "//", 
   "FullSimplify"}]}]}], "Input",
 CellChangeTimes->{{3.985782755232065*^9, 3.985782810249435*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"a25c90ab-dc54-44da-8d6b-64770adc6913"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"I1", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"R2", " ", "Vfs"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"R2", "+", "R3"}], ")"}], " ", "Vpwm"}]}], 
      RowBox[{
       RowBox[{"R2", " ", "R3"}], "+", 
       RowBox[{"R1", " ", 
        RowBox[{"(", 
         RowBox[{"R2", "+", "R3"}], ")"}]}]}]]}], ",", 
    RowBox[{"I2", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"R1", " ", "Vfs"}], "+", 
       RowBox[{"R3", " ", "Vpwm"}]}], 
      RowBox[{
       RowBox[{"R2", " ", "R3"}], "+", 
       RowBox[{"R1", " ", 
        RowBox[{"(", 
         RowBox[{"R2", "+", "R3"}], ")"}]}]}]]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.985782803769712*^9, 3.9857828105642147`*^9}},
 CellLabel->"Out[6]=",ExpressionUUID->"b15b3820-59b6-4d2f-aecd-316b5f5ed49f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Itot", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"I1", "+", "I2"}], "/.", "sol"}], "//", "FullSimplify"}], "//", 
   "ExpandAll"}]}]], "Input",
 CellChangeTimes->{{3.98578281635963*^9, 3.985782872629801*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"2b199a2f-24b4-4f3b-9c58-b25d6e687ec8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"R1", " ", "Vfs"}], 
    RowBox[{
     RowBox[{"R1", " ", "R2"}], "+", 
     RowBox[{"R1", " ", "R3"}], "+", 
     RowBox[{"R2", " ", "R3"}]}]], "+", 
   FractionBox[
    RowBox[{"R2", " ", "Vfs"}], 
    RowBox[{
     RowBox[{"R1", " ", "R2"}], "+", 
     RowBox[{"R1", " ", "R3"}], "+", 
     RowBox[{"R2", " ", "R3"}]}]], "-", 
   FractionBox[
    RowBox[{"R2", " ", "Vpwm"}], 
    RowBox[{
     RowBox[{"R1", " ", "R2"}], "+", 
     RowBox[{"R1", " ", "R3"}], "+", 
     RowBox[{"R2", " ", "R3"}]}]]}], "}"}]], "Output",
 CellChangeTimes->{{3.985782821172916*^9, 3.985782872919788*^9}},
